<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MODUS FOOD · Portal Gerencial</title>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800;900&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://www.gstatic.com/firebasejs/9.17.1/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.17.1/firebase-database-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.17.1/firebase-storage-compat.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
  <style>
    :root {
      --m-blue: #38bdf8; --m-blue-mid: #0284c7; --m-amber: #fbbf24;
      --m-bg: #0f1115; --m-surface: #1a1d24; --m-text: #f8fafc; --m-muted: #94a3b8; --m-border: #2a2e37;
      --font-main: 'Outfit', sans-serif;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: var(--font-main); background: var(--m-bg); color: var(--m-text); display: flex; height: 100vh; overflow: hidden; }

    /* SIDEBAR */
    .sb { width: 260px; background: #000000; border-right: 1px solid var(--m-border); display: flex; flex-direction: column; flex-shrink: 0; }
    .sb-head { padding: 30px 20px; border-bottom: 1px solid var(--m-border); }
    .sb-logo-title { font-size: 20px; font-weight: 900; color: #ffffff; display: flex; align-items: center; gap: 10px; }
    .sb-logo-title i { color: #f43f5e; background: linear-gradient(135deg, #3b82f6, #f43f5e, #f59e0b); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .sb-biz-name { font-size: 13px; font-weight: 700; color: var(--m-muted); margin-top: 5px; }
    .sb-nav { padding: 20px 10px; flex: 1; overflow-y: auto; }
    .sb-nav-sec { font-size: 10px; font-weight: 800; color: #64748b; text-transform: uppercase; letter-spacing: 1px; padding: 10px 15px 5px; }
    .sb-item { display: flex; align-items: center; gap: 12px; padding: 12px 15px; border-radius: 10px; font-size: 13px; font-weight: 700; color: #94a3b8; cursor: pointer; text-decoration: none; margin-bottom: 4px; transition: 0.2s; }
    .sb-item:hover, .sb-item.active { background: #1e293b; color: #ffffff; }
    .sb-item.active { background: #334155; box-shadow: inset 4px 0 0 #ffffff; }
    .sb-item i { width: 20px; text-align: center; font-size: 15px; }
    .sb-foot { padding: 20px; border-top: 1px solid var(--m-border); }
    .btn-exit { width: 100%; background: transparent; color: #94a3b8; border: none; padding: 10px; border-radius: 8px; font-weight: 800; cursor: pointer; display: flex; align-items: center; gap: 8px; transition: 0.2s; }
    .btn-exit:hover { color: #f43f5e; }

    /* CONTENT & DASHBOARD */
    #content { flex: 1; display: flex; flex-direction: column; overflow-y: auto; padding-bottom: 50px; }
    .portal-panel { display: none; padding: 40px; animation: fadeIn 0.3s ease; }
    .portal-panel.active { display: block; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
    
    .hd { display: flex; align-items: center; justify-content: space-between; margin-bottom: 30px; }
    .hd h1 { font-size: 28px; font-weight: 900; }
    .hd p { color: var(--m-muted); font-size: 14px; }
    .btn-save { padding: 10px 20px; border-radius: 8px; border: none; background: var(--m-blue); color: white; font-weight: 800; font-size: 13px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
    .btn-save:hover { background: var(--m-blue-mid); }
    .btn-save.amber { background: var(--m-amber); }

    /* HUGE COLORED STATS */
    .grid-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-bottom: 30px; }
    .stat-card { padding: 24px; border-radius: 14px; color: #000000; display:flex; flex-direction: column; justify-content: space-between; position:relative; overflow:hidden;}
    .stat-card::after { content:''; position:absolute; top:0; right:0; width:100px; height:100px; background:rgba(0,0,0,0.05); border-radius:50%; transform: translate(30%,-30%); }
    .sc-val { font-size: 32px; font-weight: 900; line-height:1; margin-bottom:10px; font-variant-numeric: tabular-nums; }
    .sc-lbl { font-size: 13px; font-weight: 700; opacity:0.8; }
    .st-ventas { background: #4ade80; } /* Green */
    .st-pedidos { background: #d946ef; } /* Purple */
    .st-mesas { background: #818cf8; } /* Blue */
    .st-entregas { background: #fb7185; } /* Salmon */

    /* TABLES */
    .tbl-card { background: var(--m-surface); border-radius: 16px; border: 1px solid var(--m-border); overflow: hidden; margin-bottom: 20px; box-shadow: 0 10px 25px rgba(0,0,0,0.2);}
    table { width: 100%; border-collapse: collapse; }
    th { background: #1f242e; padding: 14px 20px; text-align: left; font-size: 11px; font-weight: 800; color: var(--m-muted); text-transform: uppercase; border-bottom: 1px solid var(--m-border); }
    td { padding: 14px 20px; border-bottom: 1px solid #1f242e; font-size: 14px; color: var(--m-text); }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: #262b36; cursor:pointer;}
    .badge-ok { background: rgba(74,222,128,0.15); color: #4ade80; padding: 4px 10px; border-radius: 12px; font-size: 10px; font-weight: 800; }
    .badge-err { background: rgba(244,63,94,0.15); color: #fb7185; padding: 4px 10px; border-radius: 12px; font-size: 10px; font-weight: 800; }

    /* UNIFIED MODAL SYSTEM */
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); backdrop-filter: blur(5px); z-index: 1000; align-items: center; justify-content: center; }
    .modal-overlay.active { display: flex; }
    .modal-box { background: #0f172a; color: white; width: 100%; max-width: 900px; max-height: 90vh; border-radius: 16px; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5); }
    .mb-head { padding: 20px 24px; border-bottom: 1px solid #1e293b; display: flex; justify-content: space-between; align-items: center; }
    .mb-head h2 { font-size: 20px; font-weight: 800; }
    .mb-close { background:transparent; border:none; color:#94a3b8; font-size:24px; cursor:pointer; }
    .mb-close:hover { color:white; }
    .mb-tabs { display: flex; border-bottom: 1px solid #1e293b; background: #0b1120; padding: 0 24px;}
    .mb-tab { padding: 15px 20px; font-size: 12px; font-weight: 800; color: #64748b; cursor: pointer; text-transform: uppercase; border-bottom: 2px solid transparent; }
    .mb-tab.active { color: #38bdf8; border-bottom-color: #38bdf8; }
    .mb-body { padding: 24px; overflow-y: auto; flex: 1; background: #0f172a;}
    .mb-foot { padding: 16px 24px; border-top: 1px solid #1e293b; display: flex; justify-content: flex-end; gap: 10px; background: #0b1120;}
    
    /* MODAL FORMS */
    .m-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .f-grp { margin-bottom: 16px; }
    .f-grp label { display: block; font-size: 11px; font-weight: 700; color: #94a3b8; margin-bottom: 6px; text-transform: uppercase;}
    .f-inp { width: 100%; background: #1e293b; border: 1px solid #334155; color: white; font-family: inherit; padding: 12px; border-radius: 8px; outline: none;}
    .f-inp:focus { border-color: #38bdf8; }
    .btn-m { background: #38bdf8; color: #0f172a; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 800; cursor: pointer; }

    .flbl { font-size:11px; font-weight:800; color:var(--m-muted); text-transform:uppercase; letter-spacing:.06em; display:block; margin-bottom:5px; }
    .rep-kpi { border-radius:14px; padding:18px 20px; border:1px solid var(--m-border); background:var(--m-surface); }
    .rep-kpi-lbl { font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:.08em; color:var(--m-muted); margin-bottom:6px; }
    .rep-kpi-val { font-size:26px; font-weight:900; }
    .rep-kpi.green { border-color:rgba(22,163,74,.3); background:rgba(22,163,74,.08); }
    .rep-kpi.green .rep-kpi-val { color:#16a34a; }
    .rep-kpi.red { border-color:rgba(220,38,38,.3); background:rgba(220,38,38,.08); }
    .rep-kpi.red .rep-kpi-val { color:#dc2626; }
    .rep-kpi.blue { border-color:rgba(56,189,248,.3); background:rgba(56,189,248,.08); }
    .rep-kpi.blue .rep-kpi-val { color:var(--m-blue); }
    .rep-kpi.amber { border-color:rgba(251,191,36,.3); background:rgba(251,191,36,.08); }
    .rep-kpi.amber .rep-kpi-val { color:#fbbf24; }
    .rep-tab { padding:10px 16px; border:none; background:transparent; color:var(--m-muted); font-family:var(--font-main); font-size:12px; font-weight:800; cursor:pointer; border-bottom:2px solid transparent; margin-bottom:-1px; display:inline-flex; align-items:center; gap:6px; white-space:nowrap; transition:.2s; }
    .rep-tab:hover { color:var(--m-text); }
    .rep-tab.active { color:var(--m-blue); border-bottom-color:var(--m-blue); }
    .rep-panel { display:block; }
    .mesero-card { background:var(--m-surface); border:1px solid var(--m-border); border-radius:14px; padding:18px; display:flex; flex-direction:column; gap:8px; }
    .mesero-card.top { border-color:rgba(251,191,36,.4); background:rgba(251,191,36,.07); }
    .mesero-rank { font-size:10px; font-weight:900; color:var(--m-muted); text-transform:uppercase; }
    .mesero-name { font-size:16px; font-weight:900; }
    .mesero-stat { font-size:11px; color:var(--m-muted); }
    .mesero-total { font-size:22px; font-weight:900; color:#16a34a; }
    .bar-wrap { display:flex; flex-direction:column; gap:4px; }
    .bar-lbl { display:flex; justify-content:space-between; font-size:11px; font-weight:700; }
    .bar-track { height:6px; background:rgba(255,255,255,.08); border-radius:3px; overflow:hidden; }
    .bar-fill { height:100%; border-radius:3px; transition:width .6s ease; }
    .btn-m-out { background: transparent; color: #cbd5e1; border: 1px solid #334155; padding: 10px 20px; border-radius: 8px; font-weight: 800; cursor: pointer; }
    .dyn-row { display: flex; gap: 10px; margin-bottom: 10px; align-items:center; }
    .btn-add { background: #10b981; color: white; padding: 8px 12px; border-radius: 6px; font-size: 11px; font-weight:800; border:none; cursor:pointer;}
    .btn-del { background: #ef4444; color: white; padding: 8px 12px; border-radius: 6px; font-size: 11px; font-weight:800; border:none; cursor:pointer;}
    .st-warn { font-size:11px; color:#f59e0b; margin-top:4px;}

    /* CONFIG TABS */
    .cfg-tabs { display:flex; gap:10px; margin-bottom:20px; }
    .cfg-tab { padding:10px 20px; font-size:13px; font-weight:800; border-radius:8px; cursor:pointer; border:1px solid var(--m-border); background:var(--m-surface); color:var(--m-muted); }
    .cfg-tab.active { background:#ffffff; color:#000000; border-color:#ffffff; }
    .cfg-panel { display:none; }
    .cfg-panel.active { display:block; }

    /* PORTAL — ORDENES WEB */
    .pwc { background:#1a0a2e; border:1px solid #7c3aed; border-radius:14px; padding:18px; display:flex; flex-direction:column; gap:10px; }
    .pwc-head { display:flex; align-items:center; justify-content:space-between; }
    .pwc-id { font-size:16px; font-weight:900; color:#e9d5ff; letter-spacing:.5px; }
    .pwc-badge { font-size:10px; font-weight:800; padding:3px 10px; border-radius:20px; text-transform:uppercase; }
    .pwc-badge.domicilio { background:rgba(249,115,22,.2); color:#fb923c; border:1px solid rgba(249,115,22,.4); }
    .pwc-badge.llevar,.pwc-badge.recoger { background:rgba(250,204,21,.2); color:#facc15; border:1px solid rgba(250,204,21,.4); }
    .pwc-client { font-size:13px; color:#c084fc; font-weight:700; display:flex; align-items:center; gap:6px; }
    .pwc-items { font-size:12px; color:#e9d5ff; line-height:1.6; }
    .pwc-items b { color:#a78bfa; }
    .pwc-total { font-size:14px; font-weight:900; color:#f472b6; }
    .pwc-actions { display:flex; gap:8px; }
    .pwc-btn-tomar { flex:1; padding:10px; border-radius:8px; border:none; background:linear-gradient(135deg,#7c3aed,#a855f7); color:white; font-size:13px; font-weight:800; cursor:pointer; transition:.2s; display:flex; align-items:center; justify-content:center; gap:6px; }
    .pwc-btn-tomar:hover { opacity:.9; transform:translateY(-1px); }
    .pwc-btn-ignorar { padding:10px 14px; border-radius:8px; border:1px solid rgba(239,68,68,.3); background:rgba(239,68,68,.1); color:#ef4444; font-size:13px; cursor:pointer; transition:.2s; }
    .pwc-btn-ignorar:hover { background:rgba(239,68,68,.25); }
  </style>
</head>
<body>

  <!-- SIDEBAR -->
  <div class="sb">
    <div class="sb-head">
      <div class="sb-logo-title"><i class="fa-solid fa-utensils"></i> MODUS FOOD</div>
      <div class="sb-biz-name" id="sb-biz-name">Dashboard</div>
    </div>
    
    <div class="sb-nav">
      <div class="sb-nav-sec">Principal</div>
      <a id="link-dashboard" class="sb-item active" onclick="switchPanel('dashboard', this)"><i class="fa-solid fa-grid-2"></i> Panóptico / Ventas</a>
      <a id="link-reportes" class="sb-item" onclick="switchPanel('reportes', this)"><i class="fa-solid fa-chart-pie"></i> Reportes / Auditoría</a>
      <a id="link-menu" class="sb-item" onclick="switchPanel('menu', this)"><i class="fa-solid fa-list-ul"></i> Menú / Platillos</a>
      <a id="link-inventario" class="sb-item" onclick="switchPanel('inventario', this)"><i class="fa-solid fa-box-open"></i> Inventarios / Servs.</a>

      <div class="sb-nav-sec" id="sec-operaciones">Operaciones</div>
      <a href="pos-food.html?negocio=" id="link-pos" class="sb-item"><i class="fa-solid fa-cash-register"></i> Terminal POS</a>
      <a href="cocina.html?negocio=" id="link-cocina" class="sb-item"><i class="fa-solid fa-fire-burner"></i> Cocina (KDS)</a>
      <a href="mapa-mesas.html?negocio=" id="link-mapa" class="sb-item"><i class="fa-solid fa-table-cells-large"></i> Mapa de Mesas</a>
      <a href="repartidores.html?negocio=" id="link-reparto" class="sb-item"><i class="fa-solid fa-motorcycle"></i> Reparto en Ruta</a>
      <a href="empleados.html?negocio=" id="link-empleados" class="sb-item"><i class="fa-solid fa-users"></i> Equipo / RR.HH.</a>
      
      <div class="sb-nav-sec" id="sec-fiscal">Fiscal / Libros</div>
      <a href="dte.html?negocio=" id="link-dte" class="sb-item"><i class="fa-solid fa-file-invoice-dollar"></i> Facturación DTE</a>
      <a href="contabilidad.html?negocio=" id="link-conta" class="sb-item"><i class="fa-solid fa-landmark"></i> Contabilidad SV</a>
      
      <div class="sb-nav-sec" id="sec-sistema">Sistema</div>
      <a href="portal-food-movil.html?negocio=" id="link-movil" class="sb-item"><i class="fa-solid fa-mobile-screen-button"></i> Versión Móvil</a>
      <a id="link-ajustes" class="sb-item" onclick="switchPanel('config', this)"><i class="fa-solid fa-gear"></i> Ajustes / Empresa</a>
    </div>

    <div class="sb-foot">
      <button class="btn-exit" onclick="location.href='../index.html'"><i class="fa-solid fa-right-from-bracket"></i> Salir del Portal</button>
    </div>
  </div>

  <!-- CONTENT -->
  <div id="content">
    
    <!-- DASHBOARD PANEL -->
    <div class="portal-panel active" id="panel-dashboard">
      <div class="hd">
        <div>
          <h1 id="welcome-title">Panóptico Operativo</h1>
          <p id="today-date">Cargando fecha...</p>
        </div>
        <button class="btn-save amber" onclick="abrirModalFinanzas()"><i class="fa-solid fa-money-bill-transfer"></i> Movimiento de Caja</button>
      </div>

      <div class="grid-stats">
        <div class="stat-card st-ventas">
          <div class="sc-val" id="stat-ventas">$0.00</div>
          <div class="sc-lbl">Ventas de Hoy</div>
        </div>
        <div class="stat-card st-pedidos">
          <div class="sc-val" id="stat-pedidos">0</div>
          <div class="sc-lbl">Órdenes Activas</div>
        </div>
        <div class="stat-card st-mesas">
          <div class="sc-val" id="stat-mesas">0</div>
          <div class="sc-lbl">Mesas Ocupadas</div>
        </div>
        <div class="stat-card st-entregas">
          <div class="sc-val" id="stat-reparto">0</div>
          <div class="sc-lbl">Entregas en Ruta</div>
        </div>
      </div>

      <div class="hd" style="margin-top:20px; margin-bottom:15px;">
        <h2 style="font-size:20px; font-weight:900;">Últimas Ventas y Movimientos</h2>
      </div>
      <div class="tbl-card">
        <table>
          <thead>
            <tr>
              <th>REF / ID</th>
              <th>CONCEPTO / ORIGEN</th>
              <th>TIPO</th>
              <th>MONTO</th>
              <th>FECHA</th>
            </tr>
          </thead>
          <tbody id="dash-finanzas-tbody">
            <tr><td colspan="5" style="text-align:center;">Cargando flujo de transacciones...</td></tr>
          </tbody>
        </table>
      </div>

      <!-- ██ ORDENES WEB ENTRANTES — PANÓPTICO ██ -->
      <div class="hd" style="margin-top:30px; margin-bottom:15px;">
        <div>
          <h2 style="font-size:20px; font-weight:900; display:flex; align-items:center; gap:10px;">
            <span style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;background:#7c3aed;border-radius:8px;font-size:14px">🌐</span>
            Órdenes Web Entrantes
            <span id="portal-web-count" style="background:#7c3aed;color:white;border-radius:20px;padding:2px 12px;font-size:13px;font-weight:900;display:none">0</span>
          </h2>
          <p style="color:var(--m-muted)">Pedidos recibidos por menú digital — pendientes de asignar a un mesero</p>
        </div>
        <a href="cocina.html?negocio=negocio_food_sv_demo" style="padding:10px 18px;border-radius:8px;background:#7c3aed;color:white;font-weight:800;font-size:13px;text-decoration:none;display:inline-flex;align-items:center;gap:6px">
          <i class="fa-solid fa-fire-burner"></i> Ver KDS Cocina
        </a>
      </div>

      <!-- Contenedor vacío -->
      <div id="portal-web-empty" class="tbl-card" style="padding:40px;text-align:center;color:var(--m-muted);display:flex;flex-direction:column;align-items:center;gap:10px;margin-bottom:20px">
        <i class="fa-solid fa-mobile-screen-button" style="font-size:36px;opacity:.3"></i>
        <p style="font-weight:700">Sin órdenes web pendientes</p>
        <p style="font-size:12px">Las órdenes del menú digital aparecerán aquí en tiempo real</p>
      </div>

      <!-- Grid de tarjetas web -->
      <div id="portal-web-grid" style="display:none;display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;margin-bottom:30px" id="portal-web-grid"></div>

      <!-- MOBILE APPS SECTION -->
      <div class="hd" style="margin-top:40px; margin-bottom:15px;">
        <h2 style="font-size:20px; font-weight:900;">Ecosistema Móvil</h2>
        <p>Apps optimizadas para smartphones y tablets</p>
      </div>
      <div style="display:grid; grid-template-columns: repeat(4, 1fr); gap:20px">
        <a href="pos-food-movil.html?negocio=" class="link-app-card" style="text-align:center; padding:20px; background:var(--m-surface); border-radius:15px; border:1px solid var(--m-border); text-decoration:none; color:inherit">
          <i class="fa-solid fa-cash-register" style="font-size:30px; color:#4ade80; margin-bottom:10px"></i>
          <div style="font-weight:900">App Mesero</div>
          <div style="font-size:11px; color:var(--m-muted)">POS Móvil</div>
        </a>
        <a href="app-delivery.html?negocio=" class="link-app-card" style="text-align:center; padding:20px; background:var(--m-surface); border-radius:15px; border:1px solid var(--m-border); text-decoration:none; color:inherit">
          <i class="fa-solid fa-motorcycle" style="font-size:30px; color:#d946ef; margin-bottom:10px"></i>
          <div style="font-weight:900">App Delivery</div>
          <div style="font-size:11px; color:var(--m-muted)">Gestión de Reparto</div>
        </a>
        <a href="app-empleado-food.html?negocio=" class="link-app-card" style="text-align:center; padding:20px; background:var(--m-surface); border-radius:15px; border:1px solid var(--m-border); text-decoration:none; color:inherit">
          <i class="fa-solid fa-user-tie" style="font-size:30px; color:#818cf8; margin-bottom:10px"></i>
          <div style="font-weight:900">Mi Perfil</div>
          <div style="font-size:11px; color:var(--m-muted)">Portal Empleado</div>
        </a>
        <a href="menu-cliente.html?negocio=" target="_blank" class="link-app-card" style="text-align:center; padding:20px; background:var(--m-surface); border-radius:15px; border:1px solid var(--m-border); text-decoration:none; color:inherit">
          <i class="fa-solid fa-mobile-screen-button" style="font-size:30px; color:#fb7185; margin-bottom:10px"></i>
          <div style="font-weight:900">App Clientes</div>
          <div style="font-size:11px; color:var(--m-muted)">Menú Interactivo Web</div>
        </a>
      </div>
    </div>

    <!-- REPORTES PANEL -->
    <div class="portal-panel" id="panel-reportes">
      <div class="hd">
        <div>
          <h1>Auditoría Financiera</h1>
          <p>Control integral de ingresos, gastos, merma y operación</p>
        </div>
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
          <input type="month" id="rep-mes" class="f-inp" style="width:160px" onchange="calcularReportes()">
          <button class="btn-m-out" onclick="exportarReporteExcel()"><i class="fa-solid fa-file-excel"></i> Excel</button>
          <button class="btn-m-out" onclick="exportarReportePDF()"><i class="fa-solid fa-file-pdf"></i> PDF</button>
        </div>
      </div>

      <!-- SUB-TABS -->
      <div style="display:flex;gap:4px;margin-bottom:24px;border-bottom:1px solid var(--m-border);padding-bottom:0;overflow-x:auto">
        <button class="rep-tab active" data-tab="resumen"    onclick="switchRepTab(this,'resumen')">   <i class="fa-solid fa-chart-pie"></i>    Resumen</button>
        <button class="rep-tab"        data-tab="gastos"     onclick="switchRepTab(this,'gastos')">    <i class="fa-solid fa-receipt"></i>      Gastos Fijos</button>
        <button class="rep-tab"        data-tab="merma"      onclick="switchRepTab(this,'merma')">     <i class="fa-solid fa-trash-can"></i>    Merma</button>
        <button class="rep-tab"        data-tab="meseros"    onclick="switchRepTab(this,'meseros')">   <i class="fa-solid fa-user-tie"></i>     Ventas x Mesero</button>
        <button class="rep-tab"        data-tab="corte"      onclick="switchRepTab(this,'corte')">     <i class="fa-solid fa-cash-register"></i>Corte de Caja</button>
        <button class="rep-tab"        data-tab="cierre"     onclick="switchRepTab(this,'cierre')">    <i class="fa-solid fa-calendar-check"></i>Cierre de Mes</button>
      </div>

      <!-- ══ TAB: RESUMEN ══ -->
      <div class="rep-panel" id="rep-tab-resumen">
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px">
          <div class="rep-kpi green">
            <div class="rep-kpi-lbl">Ingresos (Ventas)</div>
            <div class="rep-kpi-val" id="rep-ingresos">$0.00</div>
          </div>
          <div class="rep-kpi red">
            <div class="rep-kpi-lbl">Egresos Totales</div>
            <div class="rep-kpi-val" id="rep-egresos">$0.00</div>
          </div>
          <div class="rep-kpi blue">
            <div class="rep-kpi-lbl">Balance Neto</div>
            <div class="rep-kpi-val" id="rep-balance">$0.00</div>
          </div>
          <div class="rep-kpi amber">
            <div class="rep-kpi-lbl">Descuentos Aplicados</div>
            <div class="rep-kpi-val" id="rep-descuentos">$0.00</div>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:2fr 1fr;gap:20px">
          <div>
            <div class="tbl-card">
              <div style="padding:14px 18px;font-weight:900;border-bottom:1px solid var(--m-border);display:flex;justify-content:space-between;align-items:center">
                <span><i class="fa-solid fa-crown" style="color:#fbbf24"></i> Top Platillos</span>
                <span style="font-size:11px;color:var(--m-muted)">por cantidad vendida</span>
              </div>
              <table id="rep-top-prods">
                <thead><tr><th>Platillo</th><th style="text-align:center">Órdenes</th><th style="text-align:right">Recaudado</th></tr></thead>
                <tbody><tr><td colspan="3" align="center" style="color:var(--m-muted)">Selecciona un mes</td></tr></tbody>
              </table>
            </div>
            <div class="tbl-card">
              <div style="padding:14px 18px;font-weight:900;border-bottom:1px solid var(--m-border)"><i class="fa-solid fa-percent" style="color:#f59e0b"></i> Descuentos del Período</div>
              <table id="rep-tbl-descuentos">
                <thead><tr><th>Orden</th><th>Motivo</th><th>DUI Supervisor</th><th style="text-align:right">Monto</th></tr></thead>
                <tbody><tr><td colspan="4" align="center" style="color:var(--m-muted)">Sin datos</td></tr></tbody>
              </table>
            </div>
          </div>
          <div style="display:flex;flex-direction:column;gap:16px">
            <div class="tbl-card" style="padding:20px;background:var(--m-blue);color:white">
              <h3 style="font-size:14px;margin-bottom:14px;opacity:.8">Operación del Mes</h3>
              <div style="display:flex;flex-direction:column;gap:12px">
                <div><div style="font-size:9px;opacity:.7;font-weight:800;text-transform:uppercase">Tickets Emitidos</div><div style="font-size:22px;font-weight:900" id="rep-total-tickets">0</div></div>
                <div><div style="font-size:9px;opacity:.7;font-weight:800;text-transform:uppercase">Ticket Promedio</div><div style="font-size:22px;font-weight:900" id="rep-avg-ticket">$0.00</div></div>
                <div><div style="font-size:9px;opacity:.7;font-weight:800;text-transform:uppercase">Canal Principal</div><div style="font-size:22px;font-weight:900" id="rep-main-channel">—</div></div>
              </div>
            </div>
            <div class="tbl-card" style="padding:18px">
              <h3 style="font-size:13px;margin-bottom:12px;color:var(--m-muted)">Distribución de Pago</h3>
              <div id="rep-payment-dist" style="display:flex;flex-direction:column;gap:8px"></div>
            </div>
            <div class="tbl-card" style="padding:18px">
              <h3 style="font-size:13px;margin-bottom:12px;color:var(--m-muted)">Balance Rápido</h3>
              <div id="rep-balance-bars" style="display:flex;flex-direction:column;gap:8px"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- ══ TAB: GASTOS FIJOS ══ -->
      <div class="rep-panel" id="rep-tab-gastos" style="display:none">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px">
          <div>
            <div style="font-size:16px;font-weight:900">Gastos Fijos del Mes</div>
            <div style="font-size:12px;color:var(--m-muted);margin-top:3px">Renta, planilla, luz, agua, gas, insumos, etc.</div>
          </div>
          <button class="btn-m" onclick="abrirModalGasto()"><i class="fa-solid fa-plus"></i> Registrar Gasto</button>
        </div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:20px">
          <div class="rep-kpi red"><div class="rep-kpi-lbl">Total Gastos del Mes</div><div class="rep-kpi-val" id="g-total">$0.00</div></div>
          <div class="rep-kpi amber"><div class="rep-kpi-lbl">Categoría Principal</div><div class="rep-kpi-val" style="font-size:18px" id="g-cat-top">—</div></div>
          <div class="rep-kpi blue"><div class="rep-kpi-lbl">Nro. Registros</div><div class="rep-kpi-val" id="g-count">0</div></div>
        </div>
        <div class="tbl-card">
          <table id="tbl-gastos">
            <thead><tr><th>Fecha</th><th>Categoría</th><th>Descripción</th><th>Proveedor</th><th style="text-align:right">Monto</th><th></th></tr></thead>
            <tbody><tr><td colspan="6" align="center" style="color:var(--m-muted);padding:30px">Sin gastos registrados para este mes</td></tr></tbody>
          </table>
        </div>
      </div>

      <!-- ══ TAB: MERMA ══ -->
      <div class="rep-panel" id="rep-tab-merma" style="display:none">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px">
          <div>
            <div style="font-size:16px;font-weight:900">Registro de Merma</div>
            <div style="font-size:12px;color:var(--m-muted);margin-top:3px">Productos perdidos, caducados, derramados o mal preparados — sin generar venta</div>
          </div>
          <button class="btn-m" onclick="abrirModalMerma()"><i class="fa-solid fa-plus"></i> Registrar Merma</button>
        </div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:20px">
          <div class="rep-kpi red"><div class="rep-kpi-lbl">Costo Merma del Mes</div><div class="rep-kpi-val" id="m-total">$0.00</div></div>
          <div class="rep-kpi amber"><div class="rep-kpi-lbl">Producto más Mermado</div><div class="rep-kpi-val" style="font-size:18px" id="m-top">—</div></div>
          <div class="rep-kpi blue"><div class="rep-kpi-lbl">Registros</div><div class="rep-kpi-val" id="m-count">0</div></div>
        </div>
        <div class="tbl-card">
          <table id="tbl-merma">
            <thead><tr><th>Fecha</th><th>Producto</th><th>Motivo</th><th style="text-align:center">Cantidad</th><th>Responsable</th><th style="text-align:right">Costo</th><th></th></tr></thead>
            <tbody><tr><td colspan="7" align="center" style="color:var(--m-muted);padding:30px">Sin merma registrada para este mes</td></tr></tbody>
          </table>
        </div>
      </div>

      <!-- ══ TAB: VENTAS POR MESERO ══ -->
      <div class="rep-panel" id="rep-tab-meseros" style="display:none">
        <div style="margin-bottom:18px">
          <div style="font-size:16px;font-weight:900">Ventas por Mesero</div>
          <div style="font-size:12px;color:var(--m-muted);margin-top:3px">Rendimiento individual por servidor — período seleccionado</div>
        </div>
        <div id="meseros-ranking" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px;margin-bottom:24px"></div>
        <div class="tbl-card">
          <div style="padding:14px 18px;font-weight:900;border-bottom:1px solid var(--m-border)"><i class="fa-solid fa-table"></i> Detalle por Mesero</div>
          <table id="tbl-meseros">
            <thead><tr><th>#</th><th>Mesero / Cajero</th><th style="text-align:center">Órdenes</th><th style="text-align:center">Ticket Prom.</th><th style="text-align:right;color:#f97316">Descuentos</th><th style="text-align:right">Total Vendido</th></tr></thead>
            <tbody><tr><td colspan="5" align="center" style="color:var(--m-muted);padding:30px">Sin datos para este período</td></tr></tbody>
          </table>
        </div>
      </div>

      <!-- ══ TAB: CORTE DE CAJA ══ -->
      <div class="rep-panel" id="rep-tab-corte" style="display:none">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;flex-wrap:wrap;gap:12px">
          <div>
            <div style="font-size:16px;font-weight:900">Corte de Caja</div>
            <div style="font-size:12px;color:var(--m-muted);margin-top:3px">Cuadre diario — efectivo esperado vs contado físicamente</div>
          </div>
          <div style="display:flex;gap:10px;align-items:center">
            <input type="date" id="corte-fecha" class="f-inp" style="width:160px">
            <button class="btn-m" onclick="calcularCorte()"><i class="fa-solid fa-calculator"></i> Calcular</button>
            <button class="btn-m-out" onclick="guardarCorte()"><i class="fa-solid fa-floppy-disk"></i> Guardar Corte</button>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px">
          <div>
            <div class="tbl-card" style="padding:22px">
              <h3 style="font-size:14px;font-weight:900;margin-bottom:16px;color:var(--m-muted);text-transform:uppercase;letter-spacing:.06em">Sistema — Ventas del Día</h3>
              <div style="display:flex;flex-direction:column;gap:12px">
                <div style="display:flex;justify-content:space-between"><span>Ventas en Efectivo</span><span style="font-weight:900;color:#16a34a" id="corte-efec-sistema">$0.00</span></div>
                <div style="display:flex;justify-content:space-between"><span>Ventas Tarjeta</span><span style="font-weight:900" id="corte-tarj-sistema">$0.00</span></div>
                <div style="display:flex;justify-content:space-between"><span>Ventas Transferencia</span><span style="font-weight:900" id="corte-transf-sistema">$0.00</span></div>
                <div style="display:flex;justify-content:space-between"><span>Descuentos Aplicados</span><span style="font-weight:900;color:#f59e0b" id="corte-desc-sistema">-$0.00</span></div>
                <hr style="border-color:var(--m-border)">
                <div style="display:flex;justify-content:space-between;font-size:16px"><span style="font-weight:900">Total Esperado</span><span style="font-weight:900;color:var(--m-blue)" id="corte-esperado">$0.00</span></div>
              </div>
            </div>
          </div>
          <div>
            <div class="tbl-card" style="padding:22px">
              <h3 style="font-size:14px;font-weight:900;margin-bottom:16px;color:var(--m-muted);text-transform:uppercase;letter-spacing:.06em">Físico — Conteo de Caja</h3>
              <div style="display:flex;flex-direction:column;gap:12px">
                <div><label style="font-size:11px;font-weight:700;color:var(--m-muted)">Efectivo contado en caja ($)</label><input type="number" id="corte-contado-efec" class="f-inp" style="margin-top:5px" placeholder="0.00" step="0.01" oninput="calcularDiferencia()"></div>
                <div><label style="font-size:11px;font-weight:700;color:var(--m-muted)">Fondo de cambio inicial ($)</label><input type="number" id="corte-fondo" class="f-inp" style="margin-top:5px" placeholder="0.00" step="0.01" oninput="calcularDiferencia()"></div>
                <div><label style="font-size:11px;font-weight:700;color:var(--m-muted)">Observaciones</label><textarea id="corte-obs" class="f-inp" rows="2" style="margin-top:5px;resize:vertical" placeholder="Notas del cierre..."></textarea></div>
                <hr style="border-color:var(--m-border)">
                <div style="display:flex;justify-content:space-between;font-size:16px;align-items:center">
                  <span style="font-weight:900">Diferencia</span>
                  <span style="font-weight:900;font-size:20px" id="corte-diferencia">$0.00</span>
                </div>
                <div id="corte-estado-badge" style="text-align:center;padding:8px;border-radius:8px;font-size:12px;font-weight:800">Ingresa los datos para ver el estado</div>
              </div>
            </div>
          </div>
        </div>
        <div class="tbl-card" style="margin-top:20px">
          <div style="padding:14px 18px;font-weight:900;border-bottom:1px solid var(--m-border)"><i class="fa-solid fa-clock-rotate-left"></i> Historial de Cortes</div>
          <table id="tbl-cortes">
            <thead><tr><th>Fecha</th><th style="text-align:right">Esperado</th><th style="text-align:right">Contado</th><th style="text-align:right">Diferencia</th><th>Estado</th><th>Responsable</th></tr></thead>
            <tbody><tr><td colspan="6" align="center" style="color:var(--m-muted);padding:20px">Sin cortes registrados</td></tr></tbody>
          </table>
        </div>
      </div>

      <!-- ══ TAB: CIERRE DE MES ══ -->
      <div class="rep-panel" id="rep-tab-cierre" style="display:none">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px">
          <div>
            <div style="font-size:16px;font-weight:900">Cierre de Mes</div>
            <div style="font-size:12px;color:var(--m-muted);margin-top:3px">Resumen consolidado — P&amp;L del período seleccionado</div>
          </div>
          <div style="display:flex;gap:10px">
            <button class="btn-m-out" onclick="exportarCierrePDF()"><i class="fa-solid fa-file-pdf"></i> Exportar Cierre</button>
            <button class="btn-m" onclick="calcularCierre()"><i class="fa-solid fa-rotate"></i> Recalcular</button>
          </div>
        </div>
        <div id="cierre-contenido">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px">
            <div class="tbl-card" style="padding:22px">
              <h3 style="font-size:13px;font-weight:900;margin-bottom:16px;text-transform:uppercase;letter-spacing:.06em;color:var(--m-muted)">INGRESOS</h3>
              <div style="display:flex;flex-direction:column;gap:10px">
                <div style="display:flex;justify-content:space-between"><span>Ventas Mesa</span><span style="font-weight:900" id="ci-venta-mesa">$0.00</span></div>
                <div style="display:flex;justify-content:space-between"><span>Ventas Para Llevar</span><span style="font-weight:900" id="ci-venta-llevar">$0.00</span></div>
                <div style="display:flex;justify-content:space-between"><span>Ventas Delivery</span><span style="font-weight:900" id="ci-venta-delivery">$0.00</span></div>
                <div style="display:flex;justify-content:space-between"><span>Propinas</span><span style="font-weight:900" id="ci-propinas">$0.00</span></div>
                <hr style="border-color:var(--m-border)">
                <div style="display:flex;justify-content:space-between;font-size:16px"><span style="font-weight:900">Total Ingresos</span><span style="font-weight:900;color:#16a34a" id="ci-total-ingresos">$0.00</span></div>
              </div>
            </div>
            <div class="tbl-card" style="padding:22px">
              <h3 style="font-size:13px;font-weight:900;margin-bottom:16px;text-transform:uppercase;letter-spacing:.06em;color:var(--m-muted)">EGRESOS</h3>
              <div style="display:flex;flex-direction:column;gap:10px">
                <div style="display:flex;justify-content:space-between"><span>Gastos Fijos</span><span style="font-weight:900;color:#dc2626" id="ci-gastos-fijos">$0.00</span></div>
                <div style="display:flex;justify-content:space-between"><span>Merma</span><span style="font-weight:900;color:#dc2626" id="ci-merma">$0.00</span></div>
                <div style="display:flex;justify-content:space-between"><span>Descuentos</span><span style="font-weight:900;color:#f59e0b" id="ci-descuentos-eg">$0.00</span></div>
                <div style="display:flex;justify-content:space-between"><span>Otros Egresos</span><span style="font-weight:900;color:#dc2626" id="ci-otros-eg">$0.00</span></div>
                <hr style="border-color:var(--m-border)">
                <div style="display:flex;justify-content:space-between;font-size:16px"><span style="font-weight:900">Total Egresos</span><span style="font-weight:900;color:#dc2626" id="ci-total-egresos">$0.00</span></div>
              </div>
            </div>
          </div>
          <div class="tbl-card" style="padding:24px;text-align:center" id="ci-resultado-card">
            <div style="font-size:12px;font-weight:800;color:var(--m-muted);text-transform:uppercase;letter-spacing:.1em;margin-bottom:8px">RESULTADO NETO DEL MES</div>
            <div style="font-size:48px;font-weight:900" id="ci-resultado-neto">$0.00</div>
            <div style="font-size:13px;font-weight:700;margin-top:8px" id="ci-resultado-label">Selecciona un mes y presiona Recalcular</div>
          </div>
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:16px">
            <div class="rep-kpi blue"><div class="rep-kpi-lbl">Margen Bruto</div><div class="rep-kpi-val" id="ci-margen">0%</div></div>
            <div class="rep-kpi green"><div class="rep-kpi-lbl">Días Operados</div><div class="rep-kpi-val" id="ci-dias">0</div></div>
            <div class="rep-kpi amber"><div class="rep-kpi-lbl">Promedio Diario</div><div class="rep-kpi-val" id="ci-prom-dia">$0.00</div></div>
          </div>
        </div>
      </div>
    </div>

    <!-- ══ MODAL GASTO ══ -->
    <div class="portal-modal-overlay" id="mod-gasto" style="display:none">
      <div class="portal-modal" style="max-width:440px">
        <div class="pm-head"><h3><i class="fa-solid fa-receipt"></i> Registrar Gasto Fijo</h3><button onclick="closeModal('mod-gasto')">✕</button></div>
        <div class="pm-body" style="display:flex;flex-direction:column;gap:14px">
          <div><label class="flbl">Fecha</label><input type="date" id="g-fecha" class="f-inp"></div>
          <div><label class="flbl">Categoría</label>
            <select id="g-cat" class="f-inp">
              <option value="Renta">Renta / Alquiler</option>
              <option value="Planilla">Planilla / Sueldos</option>
              <option value="Electricidad">Electricidad</option>
              <option value="Agua">Agua</option>
              <option value="Gas">Gas</option>
              <option value="Internet">Internet / Teléfono</option>
              <option value="Insumos">Insumos / Materiales</option>
              <option value="Mantenimiento">Mantenimiento</option>
              <option value="Marketing">Marketing / Publicidad</option>
              <option value="Otro">Otro</option>
            </select>
          </div>
          <div><label class="flbl">Descripción</label><input type="text" id="g-desc" class="f-inp" placeholder="Ej: Pago renta local junio"></div>
          <div><label class="flbl">Proveedor / A quién se pagó</label><input type="text" id="g-prov" class="f-inp" placeholder="Nombre del proveedor"></div>
          <div><label class="flbl">Monto ($)</label><input type="number" id="g-monto" class="f-inp" placeholder="0.00" step="0.01" min="0"></div>
          <div style="display:flex;gap:10px;justify-content:flex-end">
            <button class="btn-m-out" onclick="closeModal('mod-gasto')">Cancelar</button>
            <button class="btn-m" onclick="guardarGasto()"><i class="fa-solid fa-floppy-disk"></i> Guardar</button>
          </div>
        </div>
      </div>
    </div>

    <!-- ══ MODAL MERMA ══ -->
    <div class="portal-modal-overlay" id="mod-merma" style="display:none">
      <div class="portal-modal" style="max-width:440px">
        <div class="pm-head"><h3><i class="fa-solid fa-trash-can"></i> Registrar Merma</h3><button onclick="closeModal('mod-merma')">✕</button></div>
        <div class="pm-body" style="display:flex;flex-direction:column;gap:14px">
          <div><label class="flbl">Fecha</label><input type="date" id="mr-fecha" class="f-inp"></div>
          <div><label class="flbl">Producto / Ingrediente</label><input type="text" id="mr-prod" class="f-inp" placeholder="Ej: Carne de res, Tomates, Cerveza"></div>
          <div><label class="flbl">Motivo de la Merma</label>
            <select id="mr-motivo" class="f-inp">
              <option value="Caducado">Caducado / Vencido</option>
              <option value="Derramado">Derramado / Accidente</option>
              <option value="Mal preparado">Mal preparado</option>
              <option value="Dañado">Dañado en almacén</option>
              <option value="Robo">Robo / Faltante</option>
              <option value="Otro">Otro</option>
            </select>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
            <div><label class="flbl">Cantidad</label><input type="number" id="mr-cant" class="f-inp" placeholder="1" min="0" step="0.1"></div>
            <div><label class="flbl">Unidad</label><input type="text" id="mr-unidad" class="f-inp" placeholder="Ej: kg, unidades, litros"></div>
          </div>
          <div><label class="flbl">Costo Estimado ($)</label><input type="number" id="mr-costo" class="f-inp" placeholder="0.00" step="0.01" min="0"></div>
          <div><label class="flbl">Responsable</label><input type="text" id="mr-resp" class="f-inp" placeholder="Nombre del empleado que reporta"></div>
          <div style="display:flex;gap:10px;justify-content:flex-end">
            <button class="btn-m-out" onclick="closeModal('mod-merma')">Cancelar</button>
            <button class="btn-m" onclick="guardarMerma()"><i class="fa-solid fa-floppy-disk"></i> Guardar</button>
          </div>
        </div>
      </div>
    </div>

    <!-- MENU PANEL -->
    <div class="portal-panel" id="panel-menu">
      <div class="hd">
        <div>
          <h1>Menú / Platillos</h1>
          <p>Ficha de platillos con ingredientes, categorías y extras</p>
        </div>
        <div style="display:flex; gap:10px">
            <button id="btn-del-masivo" class="btn-m-out" style="display:none; color:var(--ff-red); border-color:var(--ff-red)" onclick="eliminarMasivoMenu()"><i class="fa-solid fa-trash-can"></i> Eliminar Selección</button>
            <button class="btn-m-out" onclick="descargarPlantillaMenu()"><i class="fa-solid fa-download"></i> Plantilla</button>
            <button class="btn-m-out" onclick="document.getElementById('xlsx-menu').click()"><i class="fa-solid fa-file-import"></i> Subida Masiva</button>
            <input type="file" id="xlsx-menu" style="display:none" accept=".xlsx, .xls, .csv" onchange="importarMenuExcel(this)">
            <button class="btn-m" onclick="abrirFichaMenu('nuevo')"><i class="fa-solid fa-plus"></i> Nuevo Platillo</button>
        </div>
      </div>

      <!-- Layout 2 columnas: Categorias | Tabla -->
      <div style="display:grid; grid-template-columns:230px 1fr; gap:20px; align-items:start">

        <!-- PANEL CATEGORIAS -->
        <div style="background:var(--m-surface); border-radius:16px; border:1px solid var(--m-border); overflow:hidden">
          <div style="padding:14px 16px; border-bottom:1px solid var(--m-border); display:flex; align-items:center; justify-content:space-between">
            <div style="font-size:13px; font-weight:800">Categorías</div>
            <button class="btn-m" style="padding:5px 10px; font-size:10px" onclick="abrirModalCategoria()"><i class="fa-solid fa-plus"></i></button>
          </div>
          <div id="cats-list" style="padding:8px; display:flex; flex-direction:column; gap:4px; max-height:500px; overflow-y:auto">
            <div style="text-align:center; padding:20px; color:var(--m-muted); font-size:11px">Cargando...</div>
          </div>
        </div>

        <!-- TABLA PLATILLOS -->
        <div class="tbl-card">
          <table>
            <thead>
              <tr>
                <th width="40"><input type="checkbox" onclick="toggleAllMenu(this)"></th>
                <th>PLATILLO</th>
                <th>CATEGORÍA</th>
                <th style="text-align:right">PRECIO BASE</th>
                <th style="text-align:center">STOCK REF.</th>
                <th>ESTADO</th>
              </tr>
            </thead>
            <tbody id="menu-tbody"></tbody>
          </table>
        </div>

      </div>
    </div>

    <!-- MODAL CATEGORÍA -->
    <div class="modal-overlay" id="mod-cat">
      <div class="modal-box" style="max-width:400px">
        <div class="mb-head"><h2><i class="fa-solid fa-tag"></i> Categoría de Menú</h2><button class="mb-close" onclick="closeModal('mod-cat')">&times;</button></div>
        <div class="mb-body">
          <input type="hidden" id="cat-old-name">
          <div class="f-grp">
            <label>Nombre de la Categoría</label>
            <input type="text" id="cat-nombre" class="f-inp" placeholder="Ej: COMIDA RAPIDA, SOPAS, BEBIDAS">
          </div>
          <div class="f-grp">
            <label>Emoji / Ícono (opcional)</label>
            <input type="text" id="cat-emoji" class="f-inp" placeholder="Ej: 🍔 🍲 🥤">
          </div>
          <div class="f-grp">
            <label>Descripción (opcional)</label>
            <input type="text" id="cat-desc" class="f-inp" placeholder="Descripción breve de la categoría">
          </div>
          <div class="f-grp">
            <label>Orden de Aparición</label>
            <input type="number" id="cat-orden" class="f-inp" placeholder="1" min="1" value="1">
          </div>
        </div>
        <div class="mb-foot" style="display:flex; gap:10px; justify-content:space-between">
          <button class="btn-m-out" id="btn-del-cat" style="color:var(--ff-red); border-color:var(--ff-red); display:none" onclick="eliminarCategoria()"><i class="fa-solid fa-trash"></i> Eliminar</button>
          <div style="display:flex; gap:10px">
            <button class="btn-m-out" onclick="closeModal('mod-cat')">Cancelar</button>
            <button class="btn-m" onclick="guardarCategoria()">Guardar Categoría</button>
          </div>
        </div>
      </div>
    </div>

    <!-- INVENTARIO PANEL -->
    <div class="portal-panel" id="panel-inventario">
      <div class="hd">
        <div>
          <h1>Catálogo de Inventario y Servicios</h1>
          <p>Control de ítems, materia prima y cobros por servicio</p>
        </div>
        <div style="display:flex; gap:10px">
            <button id="btn-del-inv-masivo" class="btn-save" style="display:none; background:var(--ff-red)" onclick="eliminarMasivoInv()"><i class="fa-solid fa-trash-can"></i> Eliminar Selección</button>
            <button class="btn-save" style="background:#475569" onclick="exportarInventario()"><i class="fa-solid fa-file-excel"></i> Exportar</button>
            <button class="btn-save amber" onclick="abrirFichaInventario('nuevo')"><i class="fa-solid fa-plus"></i> Nuevo Ítem / Servicio</button>
        </div>
      </div>

      <!-- Inventory Metrics Bar -->
      <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:20px; margin-bottom:25px">
        <div style="background:var(--m-surface); padding:20px; border-radius:15px; border:1px solid var(--m-border); border-left:5px solid #4ade80">
            <div style="font-size:10px; color:var(--m-muted); font-weight:800; text-transform:uppercase">Valorización Total (Costo)</div>
            <div style="font-size:24px; font-weight:900" id="inv-val-costo">$0.00</div>
        </div>
        <div style="background:var(--m-surface); padding:20px; border-radius:15px; border:1px solid var(--m-border); border-left:5px solid #fbbf24">
            <div style="font-size:10px; color:var(--m-muted); font-weight:800; text-transform:uppercase">Ítems con Bajo Stock</div>
            <div style="font-size:24px; font-weight:900" id="inv-low-stock">0</div>
        </div>
        <div style="background:var(--m-surface); padding:20px; border-radius:15px; border:1px solid var(--m-border); border-left:5px solid #38bdf8">
            <div style="font-size:10px; color:var(--m-muted); font-weight:800; text-transform:uppercase">Total Insumos / Servicios</div>
            <div style="font-size:24px; font-weight:900" id="inv-total-items">0</div>
        </div>
      </div>

      <div style="margin-bottom:20px; display:flex; gap:20px; align-items:center">
          <input type="text" class="f-inp" style="background:white; border-color:var(--m-border); color:var(--m-text); max-width:400px" placeholder="🔍 Buscar por código o nombre..." oninput="filtrarInventario(this.value)">
          <select class="f-inp" style="background:white; border-color:var(--m-border); color:var(--m-text); max-width:200px" onchange="filtrarTipoInv(this.value)">
              <option value="">Todos los tipos</option>
              <option value="FISICO">Productos Físicos</option>
              <option value="SERVICIO">Servicios</option>
              <option value="M_PRIMA">Materia Prima</option>
          </select>
      </div>

      <div class="tbl-card">
        <table>
          <thead>
            <tr>
              <th width="40"><input type="checkbox" onclick="toggleAllInv(this)"></th>
              <th>CÓDIGO / ÍTEM</th>
              <th>TIPO / CATEGORÍA</th>
              <th style="text-align:right">COSTO</th>
              <th style="text-align:right">PV. SUGERIDO</th>
              <th style="text-align:center">STOCK ACT.</th>
              <th style="text-align:center">ESTADO</th>
            </tr>
          </thead>
          <tbody id="inv-tbody"></tbody>
        </table>
      </div>
    </div>

    <!-- CONFIG PANEL -->
    <div class="portal-panel" id="panel-config">
      <div class="hd">
        <div>
          <h1>Ajustes Institucionales</h1>
          <p>Facturación y Suscripción al Ecosistema</p>
        </div>
        <button class="btn-save" onclick="saveBizConfig()">Guardar Cambios</button>
      </div>

      <div class="cfg-tabs">
        <div class="cfg-tab active" onclick="switchCfg('emp', this)">Datos de Empresa</div>
        <div class="cfg-tab" onclick="switchCfg('pos', this)">Ajustes POS Estándar</div>
        <div class="cfg-tab" onclick="switchCfg('mod', this)" style="border-color:var(--m-amber); color:var(--m-amber)">Mi Suscripción a MODUS</div>
      </div>

      <div class="cfg-panel active" id="cfg-emp" style="background:var(--m-surface); padding:30px; border-radius:16px; border:1px solid var(--m-border);">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
          <div class="f-grp" style="grid-column:1/-1"><label style="color:var(--m-muted)">Nombre Comercial</label><input type="text" class="f-inp" style="background:#0f172a; border-color:var(--m-border); color:var(--m-text)" id="cfg-nombre"></div>
          <div class="f-grp"><label style="color:var(--m-muted)">NIT / DUI</label><input type="text" class="f-inp" style="background:#0f172a; border-color:var(--m-border); color:var(--m-text)" id="cfg-nit"></div>
          <div class="f-grp"><label style="color:var(--m-muted)">NRC</label><input type="text" class="f-inp" style="background:#0f172a; border-color:var(--m-border); color:var(--m-text)" id="cfg-nrc"></div>
          <div class="f-grp"><label style="color:var(--m-muted)">Teléfono</label><input type="text" class="f-inp" style="background:#0f172a; border-color:var(--m-border); color:var(--m-text)" id="cfg-tel"></div>
        </div>
      </div>

      <div class="cfg-panel" id="cfg-pos" style="background:var(--m-surface); padding:30px; border-radius:16px; border:1px solid var(--m-border);">
        <div class="f-grp"><label style="color:var(--m-muted)">Token API Facturación DTE</label><input type="text" class="f-inp" style="background:#0f172a; border-color:var(--m-border); color:var(--m-text)" id="cfg-token" placeholder="Bearer eyJhbGciOiJIUzI1..."></div>
        <div class="f-grp">
          <label style="color:var(--m-muted)">Modo de Facturación por Defecto</label>
          <select class="f-inp" style="background:#0f172a; border-color:var(--m-border); color:var(--m-text)">
             <option>TICKET INTERNO</option>
             <option>FACTURA CONSUMIDOR FINAL (DTE)</option>
             <option>COMPROBANTE CRÉDITO FISCAL (DTE)</option>
          </select>
        </div>
      </div>

      <div class="cfg-panel" id="cfg-mod" style="background:var(--m-text); padding:30px; border-radius:16px; color:white;">
        <h2 style="font-size:24px; margin-bottom:10px; color:var(--m-amber)"><i class="fa-solid fa-gem"></i> Suscripción Activa</h2>
        <p style="color:#94a3b8; font-size:14px; margin-bottom:30px">Administra tu membresía actual y conoce tus límites operativos.</p>
        
        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:20px;">
          <div style="border:1px solid #334155; padding:20px; border-radius:12px; background:#0f172a">
            <div style="font-size:20px; font-weight:900; margin-bottom:5px">PLAN LITE</div>
            <p style="font-size:12px; color:#cbd5e1; margin-bottom:15px">POS Base, DTE, 500 ítems.</p>
            <button class="btn-m-out" style="width:100%; font-size:12px">Adquirir Básico</button>
          </div>
          <div style="border:2px solid var(--m-amber); padding:20px; border-radius:12px; background:#0f172a; position:relative">
            <span style="position:absolute; top:-10px; right:15px; background:var(--m-amber); font-size:10px; padding:3px 10px; font-weight:900; border-radius:10px;">TU PLAN (EJEMPLO)</span>
            <div style="font-size:20px; font-weight:900; margin-bottom:5px; color:white">PLAN NEXO</div>
            <p style="font-size:12px; color:#cbd5e1; margin-bottom:15px">Kitchen, Mesas, Equipo, Agendas.</p>
            <button class="btn-m" style="width:100%; font-size:12px">Actualmente Activo</button>
          </div>
          <div style="border:1px solid #334155; padding:20px; border-radius:12px; background:#0f172a">
            <div style="font-size:20px; font-weight:900; margin-bottom:5px">ALTIORA</div>
            <p style="font-size:12px; color:#cbd5e1; margin-bottom:15px">Enterprise, Ilimitado, Contabilidad.</p>
            <button class="btn-m-out" style="width:100%; font-size:12px">Escalar Plan</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL FINANZAS / CAJA -->
  <div class="modal-overlay" id="mod-fin">
    <div class="modal-box" style="max-width:500px;">
      <div class="mb-head"><h2>Inyección de Presupuesto / Gasto</h2><button class="mb-close" onclick="closeModal('mod-fin')">&times;</button></div>
      <div class="mb-body">
        <div class="f-grp">
          <label>Tipo de Operación</label>
          <select id="fin-tipo" class="f-inp">
            <option value="INGRESO">Ingreso (Entrada a Caja)</option>
            <option value="GASTO">Gasto (Salida de Caja / Pago)</option>
          </select>
        </div>
        <div class="f-grp">
          <label>Monto Total ($)</label>
          <input type="number" id="fin-monto" class="f-inp" placeholder="0.00">
        </div>
        <div class="f-grp">
          <label>Concepto / Referencia</label>
          <input type="text" id="fin-ref" class="f-inp" placeholder="Ej: Pago de Luz DTE">
        </div>
      </div>
      <div class="mb-foot">
        <button class="btn-m-out" onclick="closeModal('mod-fin')">Cancelar</button>
        <button class="btn-m" onclick="guardarFinanza()">Registrar Transacción</button>
      </div>
    </div>
  </div>

  <!-- MODAL FICHA PLATILLO RIGUROSA -->
  <div class="modal-overlay" id="mod-plat">
    <div class="modal-box">
      <div class="mb-head"><h2>Ficha de Platillo / Menú</h2><button class="mb-close" onclick="closeModal('mod-plat')">&times;</button></div>
      <div class="mb-tabs">
        <div class="mb-tab active" onclick="switchMenuTab('gral', this)">General</div>
        <div class="mb-tab" onclick="switchMenuTab('ing', this)">Ingredientes</div>
        <div class="mb-tab" onclick="switchMenuTab('var', this)">Variantes</div>
        <div class="mb-tab" onclick="switchMenuTab('ext', this)">Extras</div>
        <div class="mb-tab" onclick="switchMenuTab('inv', this)">Inventario & IVA</div>
      </div>

      <div class="mb-body">
        <input type="hidden" id="p-id">
        <!-- GENERAL -->
        <div class="ptab active" id="pt-gral">
           <div style="display:grid; grid-template-columns: 140px 1fr; gap:20px; margin-bottom:20px">
              <div style="text-align:center">
                  <div id="p-img-prev" style="width:140px; height:140px; border-radius:12px; background:#1e293b; display:flex; align-items:center; justify-content:center; overflow:hidden; border:2px dashed #334155; margin-bottom:10px">
                      <i class="fa-solid fa-image" style="font-size:40px; color:#334155"></i>
                  </div>
                  <input type="file" id="p-file" style="display:none" accept="image/*" onchange="previewImagenMenu(this)">
                  <button class="btn-m-out" style="width:100%; font-size:11px; padding:6px" onclick="document.getElementById('p-file').click()"><i class="fa-solid fa-camera"></i> Subir Foto</button>
                  <input type="hidden" id="p-img">
              </div>
              <div class="m-grid" style="grid-template-columns: 1fr 1fr">
                <div class="f-grp"><label>Nombre del Platillo</label><input type="text" id="p-nom" class="f-inp" placeholder="Hamburguesa Clásica"></div>
              <div class="f-grp"><label>Categoría</label>
                <select id="p-cat" class="f-inp">
                  <option value="">-- Cargar categorias --</option>
                </select>
              </div>
                <div class="f-grp"><label>Precio de Venta Base ($)</label><input type="number" id="p-pre" class="f-inp" placeholder="5.50"></div>
                <div class="f-grp"><label>Estado Visible</label>
                   <select id="p-est" class="f-inp"><option value="activo">Activo</option><option value="oculto">Oculto</option></select>
                </div>
              </div>
           </div>
           <div class="f-grp"><label>Descripción para Menú</label><textarea id="p-dsc" class="f-inp" rows="3" placeholder="Deliciosa carne con vegetales..."></textarea></div>
        </div>
        
        <!-- INGREDIENTES -->
        <div class="ptab" id="pt-ing" style="display:none;">
           <button class="btn-add" style="margin-bottom:15px;" onclick="addArrItem('ingredientes', {n:'',c:'',u:''})">+ Agregar Ingrediente</button>
           <div class="st-warn" style="margin-bottom:15px">* Estos insumos se descontarán automáticamente si el módulo PRODUCCIÓN está activo.</div>
           <div id="p-ing-lst"></div>
        </div>
        
        <!-- VARIANTES -->
        <div class="ptab" id="pt-var" style="display:none;">
           <button class="btn-add" style="margin-bottom:15px;" onclick="addArrItem('variantes', {n:'',p:0})">+ Agregar Variante de Tamaño/Estilo</button>
           <div id="p-var-lst"></div>
        </div>

        <!-- EXTRAS -->
        <div class="ptab" id="pt-ext" style="display:none;">
           <button class="btn-add" style="margin-bottom:15px;" onclick="addArrItem('extras', {n:'',p:0})">+ Agregar Adicional Cubierto</button>
           <div id="p-ext-lst"></div>
        </div>

        <!-- INVENTARIO & IVA -->
        <div class="ptab" id="pt-inv" style="display:none;">
          <div class="m-grid">
             <div class="f-grp"><label>¿Descontar del Stock General Físico (Plato Listo)?</label>
               <select id="p-inv-desc" class="f-inp"><option value="no">NO (Es preparado)</option><option value="si">SÍ (Es un empaque fijo)</option></select>
             </div>
             <div class="f-grp"><label>Stock Fijo Actual</label><input type="number" id="p-inv-stk" class="f-inp" placeholder="0"></div>
             <div class="f-grp"><label>Tasa Impositiva IVA (13%)</label>
               <select id="p-iva" class="f-inp"><option value="gravado">Venta Gravada (+13%)</option><option value="exento">Venta Exenta</option></select>
             </div>
          </div>
        </div>

      </div>
      <div class="mb-foot" style="display:flex; gap:10px; justify-content:space-between">
        <button class="btn-m-out" id="btn-del-menu" style="color:var(--ff-red); border-color:var(--ff-red); display:none" onclick="eliminarFichaMenu()"><i class="fa-solid fa-trash"></i> Eliminar</button>
        <div style="display:flex; gap:10px">
            <button class="btn-m-out" onclick="closeModal('mod-plat')">Volver</button>
            <button class="btn-m" onclick="guardarFichaMenu()">Guardar Ficha Técnica</button>
        </div>
      </div>
    </div>
  </div>


  <!-- MODAL FICHA INVENTARIO O SERVICIO -->
  <div class="modal-overlay" id="mod-inv">
    <div class="modal-box">
      <div class="mb-head"><h2>Ficha de Ítem / Servicio</h2><button class="mb-close" onclick="closeModal('mod-inv')">&times;</button></div>
      <div class="mb-tabs">
        <div class="mb-tab active" onclick="switchInvTab('gral', this)">General y Tipo</div>
        <div class="mb-tab" onclick="switchInvTab('stk', this)">Control Operativo</div>
      </div>
      <div class="mb-body">
        <input type="hidden" id="i-id">
        <!-- GRAL -->
        <div class="itab active" id="it-gral">
           <div class="m-grid">
             <div class="f-grp"><label>Código de Ítem</label><input type="text" id="i-cod" class="f-inp" placeholder="SRV-001 / PRD-092"></div>
             <div class="f-grp"><label>Esencialidad de Existencia</label>
                <select id="i-tipo" class="f-inp">
                  <option value="FISICO">Producto Físico (Descuenta Stock)</option>
                  <option value="SERVICIO">Servicio Brindado (Delivery, Cover, etc.)</option>
                  <option value="M_PRIMA">Materia Prima / Insumo Interno</option>
                </select>
             </div>
             <div class="f-grp" style="grid-column:1/-1"><label>Nombre del Ítem</label><input type="text" id="i-nom" class="f-inp" placeholder="Envase de cartón / Reparto Zona Norte"></div>
             <div class="f-grp"><label>Categoría</label><input type="text" id="i-cat" class="f-inp" placeholder="EMPAQUES"></div>
             <div class="f-grp"><label>Tasa IVA</label>
                <select id="i-iva" class="f-inp"><option value="gravado">Gravado (13%)</option><option value="exento">Exento</option></select>
             </div>
           </div>
        </div>
        
        <!-- STK -->
        <div class="itab" id="it-stk" style="display:none;">
           <div class="m-grid">
             <div class="f-grp"><label>Costo de Adquisición / Producción ($)</label><input type="number" id="i-costo" class="f-inp" placeholder="0.00"></div>
             <div class="f-grp"><label>Precio de Salida (Si aplica) ($)</label><input type="number" id="i-pvp" class="f-inp" placeholder="0.00"></div>
             <div class="f-grp"><label>Stock Existente</label><input type="number" id="i-stk" class="f-inp" placeholder="0"></div>
             <div class="f-grp"><label>Unidad de Medida (Ej: Lb, Pza)</label><input type="text" id="i-uni" class="f-inp" placeholder="Unidad"></div>
           </div>
        </div>
      </div>
      <div class="mb-foot" style="display:flex; gap:10px; justify-content:space-between">
        <button class="btn-m-out" id="btn-del-inv" style="color:var(--ff-red); border-color:var(--ff-red); display:none" onclick="eliminarFichaInventario()"><i class="fa-solid fa-trash"></i> Eliminar</button>
        <div style="display:flex; gap:10px">
            <button class="btn-m-out" onclick="closeModal('mod-inv')">Descartar</button>
            <button class="btn-m" onclick="guardarFichaInsumo()">Registrar en Inventario</button>
        </div>
      </div>
    </div>
  </div>


  <!-- MOTOR FIREBASE Y LOGICA JS -->
  <script src="firebase-config.js"></script>
  <script>
    // Si no hay negocioID por URL ni localStorage, usar el negocio demo
    if (!negocioID) negocioID = 'negocio_food_sv_demo';
    if(!negocioID) location.href = '../index.html';

    // Update Sidebar & Dashboard Links to maintain session persistence
    ['link-pos', 'link-cocina', 'link-mapa', 'link-reparto', 'link-empleados', 'link-dte', 'link-conta', 'link-movil'].forEach(id => {
      if(document.getElementById(id)) document.getElementById(id).href += negocioID;
    });

    // Ensure dashboard app cards also have business ID
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.link-app-card').forEach(card => {
        card.href += negocioID;
      });
    });

    document.addEventListener('DOMContentLoaded', () => {
      const now = new Date();
      document.getElementById('today-date').textContent = now.toLocaleDateString('es-SV', { weekday:'long', year:'numeric', month:'long', day:'numeric' });

      // ── SESIÓN DE OPERADOR (desde verificarPINFood en index.html) ──
      var opSession = null;
      try { opSession = JSON.parse(localStorage.getItem('food_operador_' + negocioID) || 'null'); } catch(e){}
      if (opSession) {
        // Mostrar nombre del operador y rol en sidebar
        var sbUser = document.getElementById('sb-biz-name');
        // Guardar nombre de operador para uso en POS
        window._foodOperadorNombre = opSession.nombre || 'Operador';
        window._foodOperadorRol    = opSession.rol || 'empleado';
        window._foodOperadorEmpKey = opSession.empKey || null;
        // Aplicar permisos de módulos en el portal
        if (opSession.modulos && typeof opSession.modulos === 'object') {
          aplicarPermisosFood(opSession.modulos, opSession.rol);
        }
      }

      // ── CARGAR LISTA DE EMPLEADOS (meseros, cajeros, delivery) ──
      // Esto permite seleccionar el nombre correcto en POS y reportes
      window._foodEmpleados = {};
      db.ref(`negocios/${negocioID}/empleados`).on('value', snap => {
        window._foodEmpleados = snap.val() || {};
        // Construir listas filtradas por rol para uso en POS y delivery
        window._foodMeseros = Object.entries(window._foodEmpleados)
          .filter(([k,v]) => v.rol === 'mesero' || v.puesto === 'Mesero')
          .map(([k,v]) => ({key:k, nombre:v.nombre, dui:v.dui, pin:v.pin_app}));
        window._foodCajeros = Object.entries(window._foodEmpleados)
          .filter(([k,v]) => v.rol === 'cajero' || v.puesto === 'Cajero')
          .map(([k,v]) => ({key:k, nombre:v.nombre, dui:v.dui, pin:v.pin_app}));
        window._foodDelivery = Object.entries(window._foodEmpleados)
          .filter(([k,v]) => v.rol === 'delivery' || v.puesto === 'Repartidor' || v.acceso_campo === true)
          .map(([k,v]) => ({key:k, nombre:v.nombre, dui:v.dui, pin:v.pin_app}));
      });

      // Cargar info del negocio
      db.ref(`negocios/${negocioID}/info`).on('value', snap => {
        const info = snap.val() || {};
        document.getElementById('sb-biz-name').textContent = info.nombre || 'Restaurante';
        const welcomeTxt = document.getElementById('welcome-title');
        if(welcomeTxt) {
          var opNombre = (opSession && opSession.nombre) ? opSession.nombre : (info.nombre || 'Admon');
          welcomeTxt.textContent = `¡Bienvenido, ${opNombre}!`;
        }
        
        ['nombre', 'nit', 'nrc', 'direccion', 'telefono', 'email'].forEach(k => {
           if(document.getElementById(`cfg-${k}`)) document.getElementById(`cfg-${k}`).value = info[k] || '';
        });
      });

      // Stats
      db.ref(`negocios/${negocioID}/pedidos`).on('value', snap => {
        const list = Object.values(snap.val() || {});
        const hoy = new Date().toLocaleDateString('es-SV');
        const ventasHoy = list.filter(p => p.fecha === hoy && p.estado === 'pagado').reduce((acc, p) => acc + (parseFloat(p.total) || 0), 0);
        const activos = list.filter(p => p.estado !== 'pagado' && p.estado !== 'ANULADA').length;
        document.getElementById('stat-ventas').textContent = `$${ventasHoy.toFixed(2)}`;
        document.getElementById('stat-pedidos').textContent = activos;
      });

      db.ref(`negocios/${negocioID}/mesas`).on('value', snap => {
        const ocupadas = Object.values(snap.val() || {}).filter(m => m.estado === 'ocupada' || m.estado === 'cuenta').length;
        document.getElementById('stat-mesas').textContent = ocupadas;
      });

      db.ref(`negocios/${negocioID}/repartidores`).on('value', snap => {
        const ruta = Object.values(snap.val() || {}).filter(r => r.estado === 'en_ruta').length;
        document.getElementById('stat-reparto').textContent = ruta;
      });

      // Real-time Listeners
      db.ref(`negocios/${negocioID}/productos`).on('value', renderMenu);
      db.ref(`negocios/${negocioID}/inventario_global`).on('value', renderInsumos);
      db.ref(`negocios/${negocioID}/finanzas_food`).orderByChild('ts').limitToLast(10).on('value', renderFinanzasDash);
      // Categorias del menú
      db.ref(`negocios/${negocioID}/menu_categorias`).on('value', renderCategorias);
      // ─── Órdenes Web Entrantes (Panóptico) ───
      db.ref(`negocios/${negocioID}/ordenes_web`).on('value', renderPortalWebOrders);
    });

    /* --- ORDENES WEB ENTRANTES --- */
    function renderPortalWebOrders(snap) {
      var pending = {};
      snap.forEach(c => {
        var v = c.val();
        if (v && !v.tomada_por) pending[c.key] = v;
      });
      var entries = Object.entries(pending).sort((a,b)=>(a[1].timestamp||0)-(b[1].timestamp||0));
      var count = entries.length;
      var countEl = document.getElementById('portal-web-count');
      var emptyEl = document.getElementById('portal-web-empty');
      var gridEl  = document.getElementById('portal-web-grid');
      if (!countEl||!emptyEl||!gridEl) return;

      if (count > 0) {
        countEl.textContent = count;
        countEl.style.display = 'inline-block';
        emptyEl.style.display = 'none';
        gridEl.style.display  = 'grid';
        gridEl.innerHTML = entries.map(([id,o]) => {
          var mins = Math.floor((Date.now()-(o.timestamp||Date.now()))/60000);
          var tipoLabel = o.tipo==='domicilio'?'domicilio':'llevar';
          var tipoEmoji = o.tipo==='domicilio'?'🛵':'🥡';
          var itemsHtml = (o.items||[]).slice(0,5).map(it=>`<b>${it.cant}×</b> ${it.desc}`).join('<br>');
          return `<div class="pwc">
            <div class="pwc-head">
              <div class="pwc-id">#${o.orden||id.substring(0,8)}</div>
              <div class="pwc-badge ${tipoLabel}">${tipoEmoji} ${tipoLabel}</div>
            </div>
            <div class="pwc-client"><i class="fa-solid fa-user" style="font-size:11px"></i> ${o.cliente||'—'} · ${o.telefono||'—'}</div>
            ${o.direccion?`<div style="font-size:11px;color:#a78bfa"><i class="fa-solid fa-location-dot" style="font-size:10px"></i> ${o.direccion}</div>`:''}
            <div class="pwc-items">${itemsHtml}</div>
            <div style="display:flex;justify-content:space-between;align-items:center">
              <div class="pwc-total">$${parseFloat(o.total||0).toFixed(2)}</div>
              <div style="font-size:11px;color:#a78bfa">hace ${mins}min · ${o.hora||''}</div>
            </div>
            <div class="pwc-actions">
              <button class="pwc-btn-tomar" onclick="portalTomarOrden('${id}')">
                <i class="fa-solid fa-hand-pointer"></i> Asignar al POS
              </button>
              <button class="pwc-btn-ignorar" onclick="portalIgnorarOrden('${id}')">
                <i class="fa-solid fa-xmark"></i>
              </button>
            </div>
          </div>`;
        }).join('');
      } else {
        countEl.style.display = 'none';
        emptyEl.style.display = 'flex';
        gridEl.style.display  = 'none';
        gridEl.innerHTML = '';
      }
    }

    function portalTomarOrden(id) {
      // Intentar usar el operador actual si es mesero
      var opSes = null;
      try { opSes = JSON.parse(localStorage.getItem('food_operador_' + negocioID) || 'null'); } catch(e){}
      if (opSes && (opSes.rol === 'mesero' || opSes.rol === 'cajero')) {
        // Asignar directamente al operador logueado
        window.asignarMeseroOrdenWeb(id, opSes.empKey).then(function(){
          alert('✅ Orden asignada a ' + opSes.nombre + '.');
        });
        return;
      }
      // Si hay meseros cargados, construir selector
      var meseros = window._foodMeseros || [];
      var cajeros  = window._foodCajeros  || [];
      var todos = meseros.concat(cajeros);
      if (todos.length > 0) {
        var opciones = todos.map(function(e){ return e.nombre; }).join('\n');
        var nombres  = todos.map(function(e){ return e.nombre; });
        var lista = todos.map(function(e,i){ return (i+1)+'. '+e.nombre; }).join('\n');
        var resp = prompt('Asignar orden a:\n' + lista + '\n\nEscribe el nombre o número:', '1');
        if (!resp) return;
        var selNombre;
        var num = parseInt(resp);
        if (!isNaN(num) && num >= 1 && num <= todos.length) {
          var empSel = todos[num-1];
          window.asignarMeseroOrdenWeb(id, empSel.key).then(function(){
            alert('✅ Orden asignada a ' + empSel.nombre);
          });
        } else {
          // Buscar por nombre
          var match = todos.find(function(e){ return e.nombre.toLowerCase().includes(resp.toLowerCase()); });
          if (match) {
            window.asignarMeseroOrdenWeb(id, match.key).then(function(){
              alert('✅ Orden asignada a ' + match.nombre);
            });
          } else {
            // Fallback: guardar texto libre
            var updates = {};
            updates['negocios/'+negocioID+'/ordenes_web/'+id+'/tomada_por']  = resp;
            updates['negocios/'+negocioID+'/ordenes_web/'+id+'/tomada_hora'] = new Date().toLocaleTimeString('es-SV',{hour:'2-digit',minute:'2-digit'});
            updates['negocios/'+negocioID+'/pedidos/'+id+'/tomada_por']      = resp;
            db.ref().update(updates).then(function(){ alert('✅ Orden asignada a ' + resp); });
          }
        }
        return;
      }
      // Fallback original con prompt libre
      var meseroNombre = prompt('¿Qué mesero toma esta orden web?', 'Mesero');
      if (!meseroNombre) return;
      var updates = {};
      updates['negocios/'+negocioID+'/ordenes_web/'+id+'/tomada_por']  = meseroNombre;
      updates['negocios/'+negocioID+'/ordenes_web/'+id+'/tomada_hora'] = new Date().toLocaleTimeString('es-SV',{hour:'2-digit',minute:'2-digit'});
      updates['negocios/'+negocioID+'/pedidos/'+id+'/tomada_por']      = meseroNombre;
      db.ref().update(updates).then(function(){ alert('✅ Orden asignada a ' + meseroNombre + '.'); });
    }

    function portalIgnorarOrden(id) {
      if (!confirm('¿Descartar esta orden web?')) return;
      db.ref(`negocios/${negocioID}/ordenes_web/${id}/tomada_por`).set('IGNORADA');
    }

    /* --- UI HELPERS --- */
    function switchPanel(panelId, el) {
      document.querySelectorAll('.portal-panel').forEach(p => p.classList.remove('active'));
      document.getElementById('panel-'+panelId).classList.add('active');
      document.querySelectorAll('.sb-item').forEach(i => i.classList.remove('active'));
      if(el) el.classList.add('active');
    }
    function switchCfg(p, el) {
      document.querySelectorAll('.cfg-panel').forEach(p => p.classList.remove('active'));
      document.getElementById('cfg-'+p).classList.add('active');
      document.querySelectorAll('.cfg-tab').forEach(i => i.classList.remove('active'));
      if(el) el.classList.add('active');
    }
    function openModal(id) { document.getElementById(id).classList.add('active'); }
    function closeModal(id) { document.getElementById(id).classList.remove('active'); }

    /* --- 1. FINANZAS DASHBOARD --- */
    function abrirModalFinanzas() {
       document.getElementById('fin-monto').value = "";
       document.getElementById('fin-ref').value = "";
       openModal('mod-fin');
    }
    function guardarFinanza() {
       const b = {
          tipo: document.getElementById('fin-tipo').value,
          monto: parseFloat(document.getElementById('fin-monto').value || 0),
          ref: document.getElementById('fin-ref').value.trim() || 'Movimiento manual',
          fecha: new Date().toISOString(),
          ts: Date.now()
       };
       if(b.monto <= 0) return alert('Monto inválido.');
       db.ref(`negocios/${negocioID}/finanzas_food`).push(b).then(()=>{
          closeModal('mod-fin');
       });
    }
    function renderFinanzasDash(snap) {
      const tb = document.getElementById('dash-finanzas-tbody');
      const vals = [];
      snap.forEach(c => { vals.push({id:c.key, ...c.val()}); });
      vals.sort((a,b)=> b.ts - a.ts);
      if(!vals.length) { tb.innerHTML = '<tr><td colspan="5" align="center">Sin movimientos</td></tr>'; return; }
      
      tb.innerHTML = vals.map(v => `
         <tr>
           <td style="font-size:11px; color:var(--m-muted)">${v.id.substring(1,8)}</td>
           <td style="font-weight:700">${v.ref}</td>
           <td><span class="${v.tipo==='INGRESO'?'badge-ok':'badge-err'}">${v.tipo}</span></td>
           <td style="font-weight:900">$${parseFloat(v.monto).toFixed(2)}</td>
           <td style="font-size:12px">${new Date(v.ts).toLocaleString()}</td>
         </tr>
      `).join('');
    }

    /* --- 2. CATEGORÍAS DEL MENÚ --- */
    let _categorias = [];

    function showToast(msg, isErr) {
      let t = document.getElementById('portal-toast');
      if(!t) {
        t = document.createElement('div');
        t.id = 'portal-toast';
        t.style.cssText = 'position:fixed;bottom:28px;right:28px;padding:12px 22px;border-radius:12px;font-size:13px;font-weight:800;color:white;z-index:99999;opacity:0;transition:.3s;pointer-events:none;box-shadow:0 4px 18px rgba(0,0,0,.2)';
        document.body.appendChild(t);
      }
      t.textContent = msg;
      t.style.background = isErr ? '#dc2626' : '#1B4E8B';
      t.style.opacity = '1';
      clearTimeout(t._t);
      t._t = setTimeout(() => t.style.opacity = '0', 3200);
    }

    function renderCategorias(snap) {
      const raw = snap.val() || {};
      _categorias = Object.entries(raw)
        .map(([k,v]) => ({ key: k, ...v }))
        .sort((a,b) => (a.orden||99) - (b.orden||99));

      // Panel lateral
      const list = document.getElementById('cats-list');
      if(list) {
        if(!_categorias.length) {
          list.innerHTML = '<div style="text-align:center;padding:20px;color:var(--m-muted);font-size:11px">Sin categorías.<br>Crea la primera 👆</div>';
        } else {
          list.innerHTML = _categorias.map(c => `
            <div style="display:flex;align-items:center;gap:6px;padding:8px 10px;border-radius:10px;cursor:pointer;transition:.1s"
                 onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background=''">
              <span style="font-size:18px">${c.emoji||'📋'}</span>
              <div style="flex:1;min-width:0">
                <div style="font-size:12px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${c.nombre}</div>
                ${c.descripcion?`<div style="font-size:10px;color:var(--m-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${c.descripcion}</div>`:''}
              </div>
              <button onclick="abrirModalCategoria('${c.key}')" style="width:26px;height:26px;border-radius:7px;border:1px solid var(--m-border);background:white;cursor:pointer;font-size:11px;color:var(--m-muted)" title="Editar">
                <i class="fa-solid fa-pen"></i>
              </button>
            </div>
          `).join('');
        }
      }

      // Selector en modal platillo
      const sel = document.getElementById('p-cat');
      if(sel) {
        const cur = sel.value;
        sel.innerHTML = '<option value="">-- Seleccionar --</option>' +
          _categorias.map(c => `<option value="${c.nombre}" ${cur===c.nombre?'selected':''}>${c.emoji||''} ${c.nombre}</option>`).join('');
      }
    }

    function abrirModalCategoria(key) {
      const c = key ? _categorias.find(x => x.key === key) : null;
      document.getElementById('cat-old-name').value = key || '';
      document.getElementById('cat-nombre').value = c ? (c.nombre||'') : '';
      document.getElementById('cat-emoji').value  = c ? (c.emoji||'')  : '';
      document.getElementById('cat-desc').value   = c ? (c.descripcion||'') : '';
      document.getElementById('cat-orden').value  = c ? (c.orden||1)   : (_categorias.length + 1);
      document.getElementById('btn-del-cat').style.display = key ? 'inline-flex' : 'none';
      openModal('mod-cat');
    }

    function guardarCategoria() {
      const nombre = document.getElementById('cat-nombre').value.trim().toUpperCase();
      if(!nombre) return alert('El nombre de la categoría es obligatorio');
      const key   = document.getElementById('cat-old-name').value || db.ref().push().key;
      const data  = {
        nombre,
        emoji:       document.getElementById('cat-emoji').value.trim(),
        descripcion: document.getElementById('cat-desc').value.trim(),
        orden:       parseInt(document.getElementById('cat-orden').value)||1,
        ts:          Date.now()
      };
      db.ref(`negocios/${negocioID}/menu_categorias/${key}`).set(data).then(() => {
        closeModal('mod-cat');
        showToast('✅ Categoría guardada');
      }).catch(e => alert('Error: '+e.message));
    }

    function eliminarCategoria() {
      const key = document.getElementById('cat-old-name').value;
      if(!key) return;
      if(!confirm('¿Eliminar esta categoría? Los platillos asociados no se eliminarán.')) return;
      db.ref(`negocios/${negocioID}/menu_categorias/${key}`).remove().then(() => {
        closeModal('mod-cat');
        showToast('🗑️ Categoría eliminada');
      });
    }

    /* --- 3. MENU Y PLATILLOS --- */
    let currentPlat = { id:'', _cat:'', ingredientes:[], variantes:[], extras:[] };

    function switchMenuTab(t, el) {
      document.querySelectorAll('.ptab').forEach(p => p.style.display = 'none');
      document.getElementById('pt-'+t).style.display = 'block';
      document.querySelectorAll('#mod-plat .mb-tab').forEach(i => i.classList.remove('active'));
      if(el) el.classList.add('active');
    }

    function abrirFichaMenu(idCatStr) {
      document.getElementById('btn-del-menu').style.display = (idCatStr === 'nuevo' ? 'none' : 'block');
      if(idCatStr === 'nuevo') {
         currentPlat = { id:'', _cat:'', ingredientes:[], variantes:[], extras:[] };
         document.getElementById('p-nom').value = '';
         document.getElementById('p-cat').value = '';
         document.getElementById('p-pre').value = '';
         document.getElementById('p-dsc').value = '';
         document.getElementById('p-inv-stk').value = '0';
         document.getElementById('p-img').value = '';
         document.getElementById('p-img-prev').innerHTML = '<i class="fa-solid fa-image" style="font-size:40px; color:#334155"></i>';
      } else {
         const d = JSON.parse(decodeURIComponent(idCatStr));
         currentPlat = d;
         currentPlat.ingredientes = d.ingredientes || [];
         currentPlat.variantes = d.variantes || [];
         currentPlat.extras = d.extras || [];
         document.getElementById('p-nom').value  = d.nombre    || '';
         // Sincronizar el select de categoria
         const selCat = document.getElementById('p-cat');
         if(selCat) selCat.value = d._cat || d.categoria || '';
         if(selCat && !selCat.value && (d._cat||d.categoria)) {
           // Categoria no existe en la lista — agregarla temporalmente
           const opt = document.createElement('option');
           opt.value = d._cat||d.categoria;
           opt.textContent = d._cat||d.categoria;
           selCat.appendChild(opt);
           selCat.value = d._cat||d.categoria;
         }
         document.getElementById('p-pre').value  = d.precio     || 0;
         document.getElementById('p-dsc').value = d.descripcion || '';
         document.getElementById('p-est').value = d.oculto ? 'oculto' : 'activo';
         document.getElementById('p-inv-desc').value = d.descuenta ? 'si' : 'no';
         document.getElementById('p-inv-stk').value = d.stockFijo || 0;
         document.getElementById('p-iva').value = d.gravado ? 'gravado' : 'exento';
         document.getElementById('p-img').value = d.img || '';
         if(d.img) document.getElementById('p-img-prev').innerHTML = `<img src="${d.img}" style="width:100%; height:100%; object-fit:cover">`;
         else document.getElementById('p-img-prev').innerHTML = '<i class="fa-solid fa-image" style="font-size:40px; color:#334155"></i>';
      }
      renderArrLists();
      switchMenuTab('gral', document.querySelector('#mod-plat .mb-tab'));
      openModal('mod-plat');
    }

    function previewImagenMenu(input) {
      if (input.files && input.files[0]) {
        var reader = new FileReader();
        reader.onload = function(e) {
          document.getElementById('p-img-prev').innerHTML = `<img src="${e.target.result}" style="width:100%; height:100%; object-fit:cover">`;
        }
        reader.readAsDataURL(input.files[0]);
      }
    }

    function addArrItem(listName, template) { currentPlat[listName].push(template); renderArrLists(); }
    function rmArrItem(listName, i) { currentPlat[listName].splice(i, 1); renderArrLists(); }
    function updArrItem(listName, i, field, val) { currentPlat[listName][i][field] = val; }

    function renderArrLists() {
       const iList = document.getElementById('p-ing-lst');
       iList.innerHTML = currentPlat.ingredientes.map((ig, i) => `
         <div class="dyn-row">
           <input class="f-inp" placeholder="Insumo ID" value="${ig.n||''}" onchange="updArrItem('ingredientes',${i},'n',this.value)">
           <input class="f-inp" placeholder="Cant." type="number" value="${ig.c||''}" onchange="updArrItem('ingredientes',${i},'c',this.value)">
           <input class="f-inp" placeholder="Unidad" value="${ig.u||''}" onchange="updArrItem('ingredientes',${i},'u',this.value)">
           <button class="btn-del" onclick="rmArrItem('ingredientes', ${i})"><i class="fa-solid fa-trash"></i></button>
         </div>
       `).join('');

       const vList = document.getElementById('p-var-lst');
       vList.innerHTML = currentPlat.variantes.map((v, i) => `
         <div class="dyn-row">
           <input class="f-inp" placeholder="Ej: Grande" value="${v.n||''}" onchange="updArrItem('variantes',${i},'n',this.value)">
           <input class="f-inp" placeholder="Prec. Extra" type="number" value="${v.p||0}" onchange="updArrItem('variantes',${i},'p',this.value)">
           <button class="btn-del" onclick="rmArrItem('variantes', ${i})"><i class="fa-solid fa-trash"></i></button>
         </div>
       `).join('');

       const eList = document.getElementById('p-ext-lst');
       eList.innerHTML = currentPlat.extras.map((ex, i) => `
         <div class="dyn-row">
           <input class="f-inp" placeholder="Ej: Extra Queso" value="${ex.n||''}" onchange="updArrItem('extras',${i},'n',this.value)">
           <input class="f-inp" placeholder="Costo Ext." type="number" value="${ex.p||0}" onchange="updArrItem('extras',${i},'p',this.value)">
           <button class="btn-del" onclick="rmArrItem('extras', ${i})"><i class="fa-solid fa-trash"></i></button>
         </div>
       `).join('');
    }

    async function guardarFichaMenu() {
       let cat = document.getElementById('p-cat').value.trim().toUpperCase() || 'GENERAL';
       if(!document.getElementById('p-nom').value.trim()) return alert('El nombre es obligatorio');
       
       let imgUrl = document.getElementById('p-img').value;
       const file = document.getElementById('p-file').files[0];
       
       if(file) {
          const path = `negocios/${negocioID}/menu/${Date.now()}_${file.name}`;
          const ref = firebase.storage().ref(path);
          const task = await ref.put(file);
          imgUrl = await task.ref.getDownloadURL();
       }

       const d = {
          nombre: document.getElementById('p-nom').value.trim(),
          precio: parseFloat(document.getElementById('p-pre').value||0),
          img: imgUrl,
          descripcion: document.getElementById('p-dsc').value,
          oculto: document.getElementById('p-est').value === 'oculto',
          descuenta: document.getElementById('p-inv-desc').value === 'si',
          stockFijo: parseFloat(document.getElementById('p-inv-stk').value||0),
          gravado: document.getElementById('p-iva').value === 'gravado',
          ingredientes: currentPlat.ingredientes,
          variantes: currentPlat.variantes,
          extras: currentPlat.extras
       };

       let refId = currentPlat.id;
       if(!refId) {
          db.ref(`negocios/${negocioID}/productos/${cat}`).push(d);
       } else {
          let oldCat = currentPlat._cat;
          if(oldCat !== cat) {
              db.ref(`negocios/${negocioID}/productos/${oldCat}/${refId}`).remove();
              db.ref(`negocios/${negocioID}/productos/${cat}/${refId}`).set(d);
          } else {
              db.ref(`negocios/${negocioID}/productos/${cat}/${refId}`).update(d);
          }
       }
       document.getElementById('p-file').value = ""; // Clear file
       closeModal('mod-plat');
    }

    function renderMenu(snap) {
      const tbody = document.getElementById('menu-tbody');
      const data = snap.val() || {};
      let prods = [];
      Object.keys(data).forEach(cat => {
        Object.entries(data[cat]).forEach(([id, p]) => prods.push({id, _cat: cat, ...p}));
      });
      if(!prods.length) { tbody.innerHTML = '<tr><td colspan="6" align="center">Catálogo vacío</td></tr>'; return; }
      tbody.innerHTML = prods.map(p => {
        const idStr = encodeURIComponent(JSON.stringify(p));
        return `
            <tr style="opacity:${(p.oculto||p.sinStock)?0.6:1}">
            <td onclick="event.stopPropagation()"><input type="checkbox" class="chk-menu" data-id="${p.id}" data-cat="${p._cat}"></td>
            <td onclick="abrirFichaMenu('${idStr}')" style="font-weight:700; color:var(--m-blue); cursor:pointer">${p.nombre || '<span style="color:red">Indefinido</span>'}</td>
            <td>${p._cat}</td>
            <td style="text-align:right; font-weight:900">$${parseFloat(p.precio||0).toFixed(2)}</td>
            <td style="text-align:center">${p.descuenta ? (p.stockFijo||0) : '—'}</td>
            <td><span class="${p.oculto?'badge-err':'badge-ok'}">${p.oculto?'OCULTO':'PÚBLICO'}</span></td>
            </tr>
        `;
      }).join('');

      // Listener para mostrar/ocultar borrado masivo
      document.querySelectorAll('.chk-menu').forEach(ck => {
        ck.onchange = () => {
            const count = document.querySelectorAll('.chk-menu:checked').length;
            document.getElementById('btn-del-masivo').style.display = count > 0 ? 'block' : 'none';
        };
      });
    }

    function toggleAllMenu(main) {
        document.querySelectorAll('.chk-menu').forEach(c => c.checked = main.checked);
        document.getElementById('btn-del-masivo').style.display = main.checked ? 'block' : 'none';
    }

    async function eliminarMasivoMenu() {
        const selected = document.querySelectorAll('.chk-menu:checked');
        if(!confirm(`¿Está seguro de eliminar ${selected.length} productos seleccionados? Esta acción es irreversible.`)) return;
        
        for(let ck of selected) {
            const id = ck.dataset.id;
            const cat = ck.dataset.cat;
            await db.ref(`negocios/${negocioID}/productos/${cat}/${id}`).remove();
        }
        document.getElementById('btn-del-masivo').style.display = 'none';
        alert('Eliminación masiva completada.');
    }

    function eliminarFichaMenu() {
        if(!confirm('¿Realmente desea eliminar este platillo?')) return;
        db.ref(`negocios/${negocioID}/productos/${currentPlat._cat}/${currentPlat.id}`).remove().then(() => {
            closeModal('mod-plat');
        });
    }

    /* --- 3. INVENTARIO & SERVICIOS --- */
    function switchInvTab(t, el) {
      document.querySelectorAll('.itab').forEach(p => p.style.display = 'none');
      document.getElementById('it-'+t).style.display = 'block';
      document.querySelectorAll('#mod-inv .mb-tab').forEach(i => i.classList.remove('active'));
      if(el) el.classList.add('active');
    }
    
    let currentInv = { id:'' };
    function abrirFichaInventario(idStr) {
      document.getElementById('btn-del-inv').style.display = (idStr === 'nuevo' ? 'none' : 'block');
      if(idStr === 'nuevo') {
         currentInv = { id:'' };
         document.getElementById('i-cod').value = 'ITM-'+Math.floor(Math.random()*10000);
         document.getElementById('i-tipo').value = 'FISICO';
         document.getElementById('i-nom').value = '';
         document.getElementById('i-cat').value = '';
         document.getElementById('i-iva').value = 'gravado';
         document.getElementById('i-costo').value = '0';
         document.getElementById('i-pvp').value = '0';
         document.getElementById('i-stk').value = '0';
         document.getElementById('i-uni').value = 'Unidad';
      } else {
         const d = JSON.parse(decodeURIComponent(idStr));
         currentInv = d;
         document.getElementById('i-cod').value = d.codigo || '';
         document.getElementById('i-tipo').value = d.tipo || 'FISICO';
         document.getElementById('i-nom').value = d.nombre || '';
         document.getElementById('i-cat').value = d.categoria || '';
         document.getElementById('i-iva').value = d.gravado ? 'gravado' : 'exento';
         document.getElementById('i-costo').value = d.costo || 0;
         document.getElementById('i-pvp').value = d.pvp || 0;
         document.getElementById('i-stk').value = d.stock || 0;
         document.getElementById('i-uni').value = d.unidad || 'Unidad';
      }
      switchInvTab('gral', document.querySelector('#mod-inv .mb-tab'));
      openModal('mod-inv');
    }

    function guardarFichaInsumo() {
       if(!document.getElementById('i-nom').value.trim()) return alert('Nombre requerido');
       const d = {
          codigo: document.getElementById('i-cod').value.trim(),
          tipo: document.getElementById('i-tipo').value,
          nombre: document.getElementById('i-nom').value.trim(),
          categoria: document.getElementById('i-cat').value.trim() || 'GENERAL',
          gravado: document.getElementById('i-iva').value === 'gravado',
          costo: parseFloat(document.getElementById('i-costo').value||0),
          pvp: parseFloat(document.getElementById('i-pvp').value||0),
          stock: parseFloat(document.getElementById('i-stk').value||0),
          unidad: document.getElementById('i-uni').value.trim(),
          ts: Date.now()
       };
       if(currentInv.id) {
           db.ref(`negocios/${negocioID}/inventario_global/${currentInv.id}`).update(d);
       } else {
           db.ref(`negocios/${negocioID}/inventario_global`).push(d);
       }
       closeModal('mod-inv');
    }

    function eliminarFichaInventario() {
        if(!confirm('¿Eliminar este ítem del inventario?')) return;
        db.ref(`negocios/${negocioID}/inventario_global/${currentInv.id}`).remove().then(() => {
            closeModal('mod-inv');
        });
    }

    let _invCache = [];
    let _filtroText = '';
    let _filtroTipo = '';

    function filtrarInventario(v) { _filtroText = v.toLowerCase(); renderInsumosManual(); }
    function filtrarTipoInv(v) { _filtroTipo = v; renderInsumosManual(); }

    function renderInsumosManual() {
        const tbody = document.getElementById('inv-tbody');
        let list = _invCache.filter(i => {
            const matchesText = !_filtroText || i.nombre.toLowerCase().includes(_filtroText) || (i.codigo||'').toLowerCase().includes(_filtroText);
            const matchesTipo = !_filtroTipo || i.tipo === _filtroTipo;
            return matchesText && matchesTipo;
        });

        document.getElementById('inv-total-items').textContent = list.length;
        
        let totalVal = 0;
        let lowStockCount = 0;
        
        tbody.innerHTML = list.map(i => {
            const stk = parseFloat(i.stock || 0);
            const costo = parseFloat(i.costo || 0);
            if(i.tipo !== 'SERVICIO') totalVal += (stk * costo);
            if(i.tipo === 'FISICO' && stk <= 5) lowStockCount++; // Umbral de alerta

            return `
                <tr>
                <td onclick="event.stopPropagation()"><input type="checkbox" class="chk-inv" data-id="${i.id}"></td>
                <td onclick="abrirFichaInventario('${encodeURIComponent(JSON.stringify(i))}')" style="cursor:pointer">
                    <span style="font-size:10px; color:#94a3b8; display:block">${i.codigo||''}</span><strong style="color:var(--m-blue)">${i.nombre}</strong>
                </td>
                <td onclick="abrirFichaInventario('${encodeURIComponent(JSON.stringify(i))}')" style="cursor:pointer">
                    <div style="font-size:11px; font-weight:700; color:var(--m-muted)">${i.tipo}</div>
                    <div style="font-size:10px; color:var(--m-muted)">${i.categoria}</div>
                </td>
                <td align="right" style="font-family:monospace; font-weight:700">$${costo.toFixed(2)}</td>
                <td align="right" style="font-family:monospace">$${parseFloat(i.pvp||0).toFixed(2)}</td>
                <td align="center">
                    <strong style="color:${(i.tipo==='FISICO' && stk <= 5)?'var(--ff-red)':'inherit'}">${i.tipo==='SERVICIO'?'N/A': (stk+' '+i.unidad)}</strong>
                </td>
                <td align="center">
                    <span class="${(i.tipo==='FISICO' && stk <= 5)?'badge-err':'badge-ok'}">
                        ${(i.tipo==='FISICO' && stk <= 5)?'BAJO STOCK':'ÓPTIMO'}
                    </span>
                </td>
                </tr>
            `;
        }).join('');

        // Listener para mostrar/ocultar borrado masivo
        document.querySelectorAll('.chk-inv').forEach(ck => {
            ck.onchange = () => {
                const count = document.querySelectorAll('.chk-inv:checked').length;
                document.getElementById('btn-del-inv-masivo').style.display = count > 0 ? 'block' : 'none';
            };
        });

        document.getElementById('inv-val-costo').textContent = '$' + totalVal.toFixed(2);
        document.getElementById('inv-low-stock').textContent = lowStockCount;
    }

    function toggleAllInv(main) {
        document.querySelectorAll('.chk-inv').forEach(c => c.checked = main.checked);
        document.getElementById('btn-del-inv-masivo').style.display = main.checked ? 'block' : 'none';
    }

    async function eliminarMasivoInv() {
        const selected = document.querySelectorAll('.chk-inv:checked');
        if(!confirm(`¿Desea eliminar ${selected.length} ítems del inventario/servicios? Esta acción es irreversible.`)) return;
        
        for(let ck of selected) {
            const id = ck.dataset.id;
            await db.ref(`negocios/${negocioID}/inventario_global/${id}`).remove();
        }
        document.getElementById('btn-del-inv-masivo').style.display = 'none';
        alert('Limpieza de inventario completada.');
    }

    function renderInsumos(snap) {
        _invCache = [];
        snap.forEach(c => { _invCache.push({id:c.key, ...c.val()}); });
        renderInsumosManual();
    }

    function exportarInventario() {
        if(!_invCache.length) return alert('No hay datos para exportar');
        let csv = "Codigo,Nombre,Tipo,Categoria,Costo,PrecioVenta,Stock,Unidad\n";
        _invCache.forEach(i => {
            csv += `"${i.codigo}","${i.nombre}","${i.tipo}","${i.categoria}",${i.costo},${i.pvp},${i.stock},"${i.unidad}"\n`;
        });
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement("a");
        const url = URL.createObjectURL(blob);
        link.setAttribute("href", url);
        link.setAttribute("download", `inventario_modus_food_${new Date().toLocaleDateString()}.csv`);
        link.style.visibility = 'hidden';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    /* ════════════════════════════════════════════════
       4. AUDITORÍA FINANCIERA — LÓGICA COMPLETA
    ════════════════════════════════════════════════ */

    /* ── Sub-tab switcher ── */
    function switchRepTab(el, tab) {
      document.querySelectorAll('.rep-tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.rep-panel').forEach(p => p.style.display = 'none');
      el.classList.add('active');
      document.getElementById('rep-tab-' + tab).style.display = 'block';
      // Carga específica por tab
      const mes = document.getElementById('rep-mes').value;
      if (!mes) return;
      if (tab === 'gastos')   cargarGastos(mes);
      if (tab === 'merma')    cargarMerma(mes);
      if (tab === 'meseros')  cargarMeseros(mes);
      if (tab === 'corte')    cargarHistorialCortes();
      if (tab === 'cierre')   calcularCierre();
    }

    /* ── Cálculo principal (Resumen) ── */
    async function calcularReportes() {
      const mes = document.getElementById('rep-mes').value;
      if (!mes) return;

      const [vSnap, fSnap] = await Promise.all([
        db.ref(`negocios/${negocioID}/ventas`).once('value'),
        db.ref(`negocios/${negocioID}/finanzas_food`).once('value')
      ]);

      let totalIngresos = 0, totalEgresos = 0, totalDescuentos = 0;
      let tickets = 0;
      let prodsMap = {}, channelsMap = {}, paymentsMap = {};
      let descRows = [];

      vSnap.forEach(c => {
        const v = c.val();
        const fechaV = v.fecha_iso ? v.fecha_iso.substring(0,7) : (v.fecha||'').substring(0,7);
        if (fechaV !== mes) return;
        const monto = parseFloat(v.total || 0);
        totalIngresos += monto;
        tickets++;
        const desc = parseFloat(v.descuento_monto || 0);
        if (desc > 0) { totalDescuentos += desc; descRows.push(v); }
        (v.items || []).forEach(it => {
          const n = it.desc || it.nombre || '?';
          if (!prodsMap[n]) prodsMap[n] = { n, q: 0, v: 0 };
          prodsMap[n].q += (it.cant || 1);
          prodsMap[n].v += parseFloat(it.sub || (it.cant * it.precio) || 0);
        });
        const chan = v.canal || 'mesa';
        channelsMap[chan] = (channelsMap[chan] || 0) + 1;
        const pay = v.forma_pago || 'efectivo';
        paymentsMap[pay] = (paymentsMap[pay] || 0) + monto;
      });

      fSnap.forEach(c => {
        const f = c.val();
        if (!(f.fecha||'').startsWith(mes)) return;
        const monto = parseFloat(f.monto || 0);
        if (f.tipo === 'INGRESO') totalIngresos += monto;
        else totalEgresos += monto;
      });

      // También sumar gastos y merma al egreso
      const [gSnap, mSnap] = await Promise.all([
        db.ref(`negocios/${negocioID}/gastos`).orderByChild('mes').equalTo(mes).once('value'),
        db.ref(`negocios/${negocioID}/merma`).orderByChild('mes').equalTo(mes).once('value')
      ]);
      gSnap.forEach(c => { totalEgresos += parseFloat(c.val().monto || 0); });
      mSnap.forEach(c => { totalEgresos += parseFloat(c.val().costo || 0); });
      totalEgresos += totalDescuentos;

      const balance = totalIngresos - totalEgresos;

      // KPIs
      document.getElementById('rep-ingresos').textContent   = '$' + totalIngresos.toFixed(2);
      document.getElementById('rep-egresos').textContent    = '$' + totalEgresos.toFixed(2);
      document.getElementById('rep-balance').textContent    = '$' + balance.toFixed(2);
      document.getElementById('rep-balance').style.color    = balance >= 0 ? '#16a34a' : '#dc2626';
      document.getElementById('rep-descuentos').textContent = '$' + totalDescuentos.toFixed(2);
      document.getElementById('rep-total-tickets').textContent = tickets;
      document.getElementById('rep-avg-ticket').textContent = '$' + (tickets > 0 ? (totalIngresos/tickets).toFixed(2) : '0.00');
      const bestChan = Object.entries(channelsMap).sort((a,b) => b[1]-a[1])[0];
      document.getElementById('rep-main-channel').textContent = bestChan ? bestChan[0].toUpperCase() : '—';

      // Top platillos
      const topArr = Object.values(prodsMap).sort((a,b) => b.q - a.q).slice(0,10);
      document.getElementById('rep-top-prods').querySelector('tbody').innerHTML =
        topArr.map(p => `<tr><td style="font-weight:700">${p.n}</td><td align="center">${p.q}</td><td align="right" style="font-weight:800;color:#16a34a">$${p.v.toFixed(2)}</td></tr>`).join('')
        || '<tr><td colspan="3" align="center" style="color:var(--m-muted)">Sin datos</td></tr>';

      // Distribución pago
      const payTotal = Object.values(paymentsMap).reduce((a,b) => a+b, 0);
      document.getElementById('rep-payment-dist').innerHTML = Object.entries(paymentsMap).map(([k,v]) => {
        const pct = payTotal > 0 ? (v/payTotal*100).toFixed(1) : 0;
        const colors = { efectivo:'#16a34a', tarjeta:'#38bdf8', transferencia:'#fbbf24' };
        const c = colors[k] || '#94a3b8';
        return `<div class="bar-wrap"><div class="bar-lbl"><span>${k.charAt(0).toUpperCase()+k.slice(1)}</span><span>$${v.toFixed(2)} (${pct}%)</span></div><div class="bar-track"><div class="bar-fill" style="width:${pct}%;background:${c}"></div></div></div>`;
      }).join('') || '<div style="color:var(--m-muted);font-size:12px">Sin datos</div>';

      // Balance bars
      const maxVal = Math.max(totalIngresos, totalEgresos, 1);
      document.getElementById('rep-balance-bars').innerHTML = [
        { lbl:'Ingresos', val:totalIngresos, color:'#16a34a' },
        { lbl:'Egresos',  val:totalEgresos,  color:'#dc2626' },
        { lbl:'Balance',  val:Math.abs(balance), color: balance>=0?'#38bdf8':'#f59e0b' }
      ].map(r => `<div class="bar-wrap"><div class="bar-lbl"><span>${r.lbl}</span><span style="color:${r.color}">$${r.val.toFixed(2)}</span></div><div class="bar-track"><div class="bar-fill" style="width:${(r.val/maxVal*100).toFixed(1)}%;background:${r.color}"></div></div></div>`).join('');

      // Tabla descuentos
      document.getElementById('rep-tbl-descuentos').querySelector('tbody').innerHTML =
        descRows.map(v => `<tr>
          <td style="font-weight:700">${v.orden||'—'}</td>
          <td>${v.descuento_motivo||'—'}</td>
          <td style="font-family:monospace">${v.descuento_dui||'—'}</td>
          <td align="right" style="font-weight:900;color:#f59e0b">$${parseFloat(v.descuento_monto||0).toFixed(2)}</td>
        </tr>`).join('') || '<tr><td colspan="4" align="center" style="color:var(--m-muted)">Sin descuentos aplicados</td></tr>';

      // Guardar datos globales para exportar
      window._repData = { mes, totalIngresos, totalEgresos, totalDescuentos, balance, tickets, prodsMap, paymentsMap, descRows };
    }

    /* ── GASTOS FIJOS ── */
    function abrirModalGasto() {
      const hoy = new Date().toISOString().split('T')[0];
      document.getElementById('g-fecha').value = hoy;
      document.getElementById('g-desc').value = '';
      document.getElementById('g-prov').value = '';
      document.getElementById('g-monto').value = '';
      document.getElementById('mod-gasto').style.display = 'flex';
    }

    async function guardarGasto() {
      const mes = document.getElementById('rep-mes').value;
      const fecha = document.getElementById('g-fecha').value;
      const cat  = document.getElementById('g-cat').value;
      const desc = document.getElementById('g-desc').value.trim();
      const prov = document.getElementById('g-prov').value.trim();
      const monto = parseFloat(document.getElementById('g-monto').value);
      if (!fecha || !desc || isNaN(monto) || monto <= 0) { alert('Completa todos los campos'); return; }
      await db.ref(`negocios/${negocioID}/gastos`).push({ mes: mes||fecha.substring(0,7), fecha, categoria:cat, descripcion:desc, proveedor:prov, monto, ts:Date.now() });
      closeModal('mod-gasto');
      cargarGastos(mes || fecha.substring(0,7));
    }

    async function cargarGastos(mes) {
      const snap = await db.ref(`negocios/${negocioID}/gastos`).orderByChild('mes').equalTo(mes).once('value');
      let total = 0, catsMap = {}, rows = [];
      snap.forEach(c => { const g = Object.assign({_key:c.key}, c.val()); rows.push(g); total += parseFloat(g.monto||0); catsMap[g.categoria] = (catsMap[g.categoria]||0)+parseFloat(g.monto||0); });
      rows.sort((a,b) => (b.ts||0)-(a.ts||0));
      document.getElementById('g-total').textContent = '$'+total.toFixed(2);
      document.getElementById('g-count').textContent = rows.length;
      const topCat = Object.entries(catsMap).sort((a,b)=>b[1]-a[1])[0];
      document.getElementById('g-cat-top').textContent = topCat ? topCat[0] : '—';
      document.getElementById('tbl-gastos').querySelector('tbody').innerHTML =
        rows.map(g => `<tr>
          <td>${g.fecha||'—'}</td>
          <td><span style="background:rgba(56,189,248,.15);color:var(--m-blue);padding:2px 8px;border-radius:4px;font-size:11px;font-weight:800">${g.categoria}</span></td>
          <td style="font-weight:700">${g.descripcion}</td>
          <td style="color:var(--m-muted)">${g.proveedor||'—'}</td>
          <td align="right" style="font-weight:900;color:#dc2626">$${parseFloat(g.monto||0).toFixed(2)}</td>
          <td><button onclick="eliminarGasto('${g._key}')" style="background:rgba(220,38,38,.15);border:1px solid rgba(220,38,38,.3);color:#dc2626;border-radius:6px;padding:4px 8px;cursor:pointer;font-size:11px"><i class="fa-solid fa-trash"></i></button></td>
        </tr>`).join('') || '<tr><td colspan="6" align="center" style="color:var(--m-muted);padding:30px">Sin gastos registrados</td></tr>';
    }

    async function eliminarGasto(key) {
      if (!confirm('¿Eliminar este gasto?')) return;
      await db.ref(`negocios/${negocioID}/gastos/${key}`).remove();
      cargarGastos(document.getElementById('rep-mes').value);
    }

    /* ── MERMA ── */
    function abrirModalMerma() {
      const hoy = new Date().toISOString().split('T')[0];
      document.getElementById('mr-fecha').value = hoy;
      ['mr-prod','mr-cant','mr-unidad','mr-costo','mr-resp'].forEach(id => document.getElementById(id).value = '');
      document.getElementById('mod-merma').style.display = 'flex';
    }

    async function guardarMerma() {
      const mes = document.getElementById('rep-mes').value;
      const fecha  = document.getElementById('mr-fecha').value;
      const prod   = document.getElementById('mr-prod').value.trim();
      const motivo = document.getElementById('mr-motivo').value;
      const cant   = parseFloat(document.getElementById('mr-cant').value);
      const unidad = document.getElementById('mr-unidad').value.trim();
      const costo  = parseFloat(document.getElementById('mr-costo').value);
      const resp   = document.getElementById('mr-resp').value.trim();
      if (!fecha || !prod || isNaN(cant)) { alert('Completa los campos obligatorios'); return; }
      await db.ref(`negocios/${negocioID}/merma`).push({ mes:mes||fecha.substring(0,7), fecha, producto:prod, motivo, cantidad:cant, unidad, costo:costo||0, responsable:resp, ts:Date.now() });
      closeModal('mod-merma');
      cargarMerma(mes || fecha.substring(0,7));
    }

    async function cargarMerma(mes) {
      const snap = await db.ref(`negocios/${negocioID}/merma`).orderByChild('mes').equalTo(mes).once('value');
      let total = 0, prodsMap = {}, rows = [];
      snap.forEach(c => { const m = Object.assign({_key:c.key}, c.val()); rows.push(m); total += parseFloat(m.costo||0); prodsMap[m.producto] = (prodsMap[m.producto]||0)+parseFloat(m.costo||0); });
      rows.sort((a,b) => (b.ts||0)-(a.ts||0));
      document.getElementById('m-total').textContent = '$'+total.toFixed(2);
      document.getElementById('m-count').textContent = rows.length;
      const topProd = Object.entries(prodsMap).sort((a,b)=>b[1]-a[1])[0];
      document.getElementById('m-top').textContent = topProd ? topProd[0] : '—';
      const motivoColors = { Caducado:'#dc2626', Derramado:'#f59e0b', 'Mal preparado':'#7c3aed', Dañado:'#ea580c', Robo:'#dc2626', Otro:'#94a3b8' };
      document.getElementById('tbl-merma').querySelector('tbody').innerHTML =
        rows.map(m => `<tr>
          <td>${m.fecha||'—'}</td>
          <td style="font-weight:700">${m.producto}</td>
          <td><span style="background:rgba(220,38,38,.12);color:${motivoColors[m.motivo]||'#94a3b8'};padding:2px 8px;border-radius:4px;font-size:11px;font-weight:800">${m.motivo}</span></td>
          <td align="center">${m.cantidad||0} ${m.unidad||''}</td>
          <td style="color:var(--m-muted)">${m.responsable||'—'}</td>
          <td align="right" style="font-weight:900;color:#dc2626">$${parseFloat(m.costo||0).toFixed(2)}</td>
          <td><button onclick="eliminarMerma('${m._key}')" style="background:rgba(220,38,38,.15);border:1px solid rgba(220,38,38,.3);color:#dc2626;border-radius:6px;padding:4px 8px;cursor:pointer;font-size:11px"><i class="fa-solid fa-trash"></i></button></td>
        </tr>`).join('') || '<tr><td colspan="7" align="center" style="color:var(--m-muted);padding:30px">Sin merma registrada</td></tr>';
    }

    async function eliminarMerma(key) {
      if (!confirm('¿Eliminar este registro de merma?')) return;
      await db.ref(`negocios/${negocioID}/merma/${key}`).remove();
      cargarMerma(document.getElementById('rep-mes').value);
    }

    /* ── VENTAS POR MESERO / CAJERO ── */
    async function cargarMeseros(mes) {
      const snap = await db.ref(`negocios/${negocioID}/ventas`).once('value');
      const mMap = {};
      // Cargar empleados si no están en memoria
      var empleadosSnap = window._foodEmpleados || {};
      // Función helper: normaliza nombre (por empKey o por nombre libre)
      function resolverNombreOp(v) {
        // 1. Si tiene emp_key → buscar nombre real
        if (v.emp_key && empleadosSnap[v.emp_key]) return empleadosSnap[v.emp_key].nombre;
        // 2. Si tiene cajero_key
        if (v.cajero_key && empleadosSnap[v.cajero_key]) return empleadosSnap[v.cajero_key].nombre;
        // 3. Si tiene campo 'cajero' o 'mesero' con texto
        if (v.cajero && v.cajero !== 'Sin asignar') return v.cajero;
        if (v.mesero && v.mesero !== 'Sin asignar') return v.mesero;
        // 4. Si tiene tomada_por
        if (v.tomada_por && v.tomada_por !== 'IGNORADA') return v.tomada_por;
        return 'Sin asignar';
      }

      snap.forEach(c => {
        const v = c.val();
        const fechaV = v.fecha_iso ? v.fecha_iso.substring(0,7) : (v.fecha||'').substring(0,7);
        if (fechaV !== mes) return;
        const nombre = resolverNombreOp(v);
        if (!mMap[nombre]) mMap[nombre] = { nombre, ordenes:0, total:0, descs:0 };
        mMap[nombre].ordenes++;
        mMap[nombre].total  += parseFloat(v.total||0);
        mMap[nombre].descs  += parseFloat(v.descuento_monto||0);
      });

      // También revisar en 'pedidos' (canal POS)
      const pedSnap = await db.ref(`negocios/${negocioID}/pedidos`).once('value');
      pedSnap.forEach(c => {
        const v = c.val();
        if (v.estado !== 'pagado') return;
        const fechaV = v.fecha_iso ? v.fecha_iso.substring(0,7) : (v.fecha||'').substring(0,7);
        if (fechaV !== mes) return;
        const nombre = resolverNombreOp(v);
        // Evitar duplicados si ya está en ventas
        if (!mMap[nombre]) mMap[nombre] = { nombre, ordenes:0, total:0, descs:0 };
        // Solo sumar si no fue ya contado (heurística: si no hay snap de ventas separado)
        if (!snap.exists()) {
          mMap[nombre].ordenes++;
          mMap[nombre].total += parseFloat(v.total||0);
        }
      });

      const arr = Object.values(mMap).sort((a,b) => b.total - a.total);
      const maxTotal = arr[0]?.total || 1;

      // Ranking cards
      document.getElementById('meseros-ranking').innerHTML = arr.slice(0,6).map((m,i) => `
        <div class="mesero-card ${i===0?'top':''}">
          <div class="mesero-rank">${i===0?'🥇':i===1?'🥈':i===2?'🥉':'#'+(i+1)} Lugar</div>
          <div class="mesero-name">${m.nombre}</div>
          <div class="mesero-stat">${m.ordenes} órdenes · Prom. $${(m.total/m.ordenes).toFixed(2)}</div>
          ${m.descs>0?`<div style="font-size:10px;color:#f97316;font-weight:700">Desc: -$${m.descs.toFixed(2)}</div>`:''}
          <div class="mesero-total">$${m.total.toFixed(2)}</div>
          <div class="bar-track" style="margin-top:4px"><div class="bar-fill" style="width:${(m.total/maxTotal*100).toFixed(1)}%;background:${i===0?'#fbbf24':'#38bdf8'}"></div></div>
        </div>`).join('') || '<div style="color:var(--m-muted);grid-column:1/-1;text-align:center;padding:30px">Sin datos para este período</div>';

      // Tabla completa con columna de descuentos
      document.getElementById('tbl-meseros').querySelector('tbody').innerHTML =
        arr.map((m,i) => `<tr>
          <td style="font-weight:900;color:var(--m-muted)">${i+1}</td>
          <td style="font-weight:800">${m.nombre}</td>
          <td align="center">${m.ordenes}</td>
          <td align="center">$${(m.total/m.ordenes).toFixed(2)}</td>
          <td align="right" style="color:#f97316">-$${m.descs.toFixed(2)}</td>
          <td align="right" style="font-weight:900;color:#16a34a">$${m.total.toFixed(2)}</td>
        </tr>`).join('') || '<tr><td colspan="6" align="center" style="color:var(--m-muted);padding:20px">Sin datos</td></tr>';
    }

    /* ── CORTE DE CAJA ── */
    async function calcularCorte() {
      const fecha = document.getElementById('corte-fecha').value;
      if (!fecha) { alert('Selecciona una fecha'); return; }
      const snap = await db.ref(`negocios/${negocioID}/ventas`).once('value');
      let efec=0, tarj=0, transf=0, desc=0;
      snap.forEach(c => {
        const v = c.val();
        const fv = v.fecha_iso ? v.fecha_iso.substring(0,10) : (v.fecha||'').split('/').reverse().join('-');
        if (fv !== fecha) return;
        const monto = parseFloat(v.total||0);
        const fp = (v.forma_pago||'efectivo').toLowerCase();
        if (fp === 'efectivo') efec += monto;
        else if (fp === 'tarjeta') tarj += monto;
        else transf += monto;
        desc += parseFloat(v.descuento_monto||0);
      });
      const esperado = efec + tarj + transf;
      document.getElementById('corte-efec-sistema').textContent   = '$'+efec.toFixed(2);
      document.getElementById('corte-tarj-sistema').textContent   = '$'+tarj.toFixed(2);
      document.getElementById('corte-transf-sistema').textContent = '$'+transf.toFixed(2);
      document.getElementById('corte-desc-sistema').textContent   = '-$'+desc.toFixed(2);
      document.getElementById('corte-esperado').textContent       = '$'+esperado.toFixed(2);
      window._corteEsperado = { efec, tarj, transf, desc, esperado, fecha };
      calcularDiferencia();
    }

    function calcularDiferencia() {
      const esp = (window._corteEsperado||{}).esperado || 0;
      const contado = parseFloat(document.getElementById('corte-contado-efec').value)||0;
      const fondo   = parseFloat(document.getElementById('corte-fondo').value)||0;
      const neto = contado - fondo;
      const dif = neto - esp;
      const el = document.getElementById('corte-diferencia');
      el.textContent = (dif>=0?'+':'') + '$'+dif.toFixed(2);
      el.style.color = Math.abs(dif) < 0.01 ? '#16a34a' : dif > 0 ? '#fbbf24' : '#dc2626';
      const badge = document.getElementById('corte-estado-badge');
      if (Math.abs(dif) < 0.01) { badge.textContent='✅ Cuadre Exacto'; badge.style.background='rgba(22,163,74,.2)'; badge.style.color='#16a34a'; }
      else if (dif > 0) { badge.textContent='⬆ Sobrante — $'+dif.toFixed(2); badge.style.background='rgba(251,191,36,.2)'; badge.style.color='#fbbf24'; }
      else { badge.textContent='⬇ Faltante — $'+Math.abs(dif).toFixed(2); badge.style.background='rgba(220,38,38,.2)'; badge.style.color='#dc2626'; }
    }

    async function guardarCorte() {
      const esp = window._corteEsperado;
      if (!esp) { alert('Primero calcula el corte'); return; }
      const contado = parseFloat(document.getElementById('corte-contado-efec').value)||0;
      const fondo   = parseFloat(document.getElementById('corte-fondo').value)||0;
      const obs     = document.getElementById('corte-obs').value;
      const dif     = (contado-fondo) - esp.esperado;
      await db.ref(`negocios/${negocioID}/cortes_caja`).push({
        fecha: esp.fecha, esperado: esp.esperado, contado: contado-fondo,
        diferencia: dif, fondo, observaciones:obs,
        efec:esp.efec, tarjeta:esp.tarj, transferencia:esp.transf, descuentos:esp.desc,
        estado: Math.abs(dif)<0.01?'cuadrado': dif>0?'sobrante':'faltante',
        ts: Date.now()
      });
      alert('✅ Corte guardado correctamente');
      cargarHistorialCortes();
    }

    async function cargarHistorialCortes() {
      const snap = await db.ref(`negocios/${negocioID}/cortes_caja`).orderByChild('ts').limitToLast(30).once('value');
      const rows = [];
      snap.forEach(c => rows.unshift(c.val()));
      const colors = { cuadrado:'#16a34a', sobrante:'#fbbf24', faltante:'#dc2626' };
      const labels = { cuadrado:'✅ Cuadrado', sobrante:'⬆ Sobrante', faltante:'⬇ Faltante' };
      document.getElementById('tbl-cortes').querySelector('tbody').innerHTML =
        rows.map(r => `<tr>
          <td>${r.fecha}</td>
          <td align="right">$${parseFloat(r.esperado||0).toFixed(2)}</td>
          <td align="right">$${parseFloat(r.contado||0).toFixed(2)}</td>
          <td align="right" style="font-weight:900;color:${colors[r.estado]||'#94a3b8'}">${(r.diferencia>=0?'+':'') + '$'+parseFloat(r.diferencia||0).toFixed(2)}</td>
          <td><span style="font-size:11px;font-weight:800;color:${colors[r.estado]||'#94a3b8'}">${labels[r.estado]||r.estado}</span></td>
          <td style="color:var(--m-muted)">${r.responsable||'—'}</td>
        </tr>`).join('') || '<tr><td colspan="6" align="center" style="color:var(--m-muted);padding:20px">Sin cortes registrados</td></tr>';
    }

    /* ── CIERRE DE MES ── */
    async function calcularCierre() {
      const mes = document.getElementById('rep-mes').value;
      if (!mes) return;

      const [vSnap, gSnap, mSnap] = await Promise.all([
        db.ref(`negocios/${negocioID}/ventas`).once('value'),
        db.ref(`negocios/${negocioID}/gastos`).orderByChild('mes').equalTo(mes).once('value'),
        db.ref(`negocios/${negocioID}/merma`).orderByChild('mes').equalTo(mes).once('value')
      ]);

      let ventaMesa=0, ventaLlevar=0, ventaDelivery=0, propinas=0, totalDesc=0;
      let diasSet = new Set();

      vSnap.forEach(c => {
        const v = c.val();
        const fechaV = v.fecha_iso ? v.fecha_iso.substring(0,7) : (v.fecha||'').substring(0,7);
        if (fechaV !== mes) return;
        const monto = parseFloat(v.total||0);
        const tip   = parseFloat(v.propina||0);
        const desc  = parseFloat(v.descuento_monto||0);
        propinas  += tip;
        totalDesc += desc;
        const canal = (v.canal||'mesa').toLowerCase();
        if (canal==='mesa') ventaMesa += monto;
        else if (canal==='llevar'||canal==='para_llevar') ventaLlevar += monto;
        else if (canal==='delivery') ventaDelivery += monto;
        else ventaMesa += monto;
        const dia = v.fecha_iso ? v.fecha_iso.substring(0,10) : '';
        if (dia) diasSet.add(dia);
      });

      let gastosFijos = 0;
      gSnap.forEach(c => { gastosFijos += parseFloat(c.val().monto||0); });
      let mermaTotal = 0;
      mSnap.forEach(c => { mermaTotal += parseFloat(c.val().costo||0); });

      const totalIngresos = ventaMesa + ventaLlevar + ventaDelivery + propinas;
      const otrosEgresos  = 0;
      const totalEgresos  = gastosFijos + mermaTotal + totalDesc + otrosEgresos;
      const neto = totalIngresos - totalEgresos;
      const margen = totalIngresos > 0 ? (neto/totalIngresos*100) : 0;
      const dias = diasSet.size;
      const promDia = dias > 0 ? totalIngresos/dias : 0;

      document.getElementById('ci-venta-mesa').textContent    = '$'+ventaMesa.toFixed(2);
      document.getElementById('ci-venta-llevar').textContent  = '$'+ventaLlevar.toFixed(2);
      document.getElementById('ci-venta-delivery').textContent= '$'+ventaDelivery.toFixed(2);
      document.getElementById('ci-propinas').textContent      = '$'+propinas.toFixed(2);
      document.getElementById('ci-total-ingresos').textContent= '$'+totalIngresos.toFixed(2);
      document.getElementById('ci-gastos-fijos').textContent  = '$'+gastosFijos.toFixed(2);
      document.getElementById('ci-merma').textContent         = '$'+mermaTotal.toFixed(2);
      document.getElementById('ci-descuentos-eg').textContent = '$'+totalDesc.toFixed(2);
      document.getElementById('ci-otros-eg').textContent      = '$'+otrosEgresos.toFixed(2);
      document.getElementById('ci-total-egresos').textContent = '$'+totalEgresos.toFixed(2);
      document.getElementById('ci-resultado-neto').textContent= (neto>=0?'':'- ')+'$'+Math.abs(neto).toFixed(2);
      document.getElementById('ci-resultado-neto').style.color= neto>=0?'#16a34a':'#dc2626';
      document.getElementById('ci-resultado-label').textContent = neto>=0?'📈 Mes rentable — Margen '+margen.toFixed(1)+'%':'📉 Mes en pérdida — Revisar egresos';
      document.getElementById('ci-resultado-label').style.color = neto>=0?'#16a34a':'#dc2626';
      document.getElementById('ci-margen').textContent   = margen.toFixed(1)+'%';
      document.getElementById('ci-dias').textContent     = dias;
      document.getElementById('ci-prom-dia').textContent = '$'+promDia.toFixed(2);

      window._cierreData = { mes, totalIngresos, totalEgresos, neto, margen, dias, promDia, ventaMesa, ventaLlevar, ventaDelivery, propinas, gastosFijos, mermaTotal, totalDesc };
    }

    /* ── EXPORTAR EXCEL ── */
    function exportarReporteExcel() {
      const d = window._repData;
      if (!d) { alert('Primero carga los datos del mes'); return; }
      const wb = XLSX.utils.book_new();

      // Hoja resumen
      const resumen = [
        ['AUDITORÍA FINANCIERA — ' + d.mes],[''],
        ['Ingresos Totales', d.totalIngresos],
        ['Egresos Totales', d.totalEgresos],
        ['Balance Neto', d.balance],
        ['Descuentos', d.totalDescuentos],
        ['Tickets Emitidos', d.tickets],
        ['Ticket Promedio', d.tickets>0?(d.totalIngresos/d.tickets):0]
      ];
      XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(resumen), 'Resumen');

      // Hoja top platillos
      const prods = [['Platillo','Cantidad','Recaudado'], ...Object.values(d.prodsMap).sort((a,b)=>b.q-a.q).map(p=>[p.n,p.q,p.v])];
      XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(prods), 'Top Platillos');

      // Hoja descuentos
      const descs = [['Orden','Motivo','DUI Supervisor','Monto'], ...d.descRows.map(v=>[v.orden||'',v.descuento_motivo||'',v.descuento_dui||'',parseFloat(v.descuento_monto||0)])];
      XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(descs), 'Descuentos');

      XLSX.writeFile(wb, `auditoria_${d.mes}.xlsx`);
    }

    /* ── EXPORTAR PDF (texto formateado para impresión) ── */
    function exportarReportePDF() {
      const d = window._repData;
      if (!d) { alert('Primero carga los datos del mes'); return; }
      const html = `<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Auditoría ${d.mes}</title>
      <style>body{font-family:Arial,sans-serif;padding:30px;color:#111}h1{font-size:20px}h2{font-size:14px;margin-top:20px;border-bottom:1px solid #ccc}table{width:100%;border-collapse:collapse;margin-top:10px}th,td{padding:8px;text-align:left;border-bottom:1px solid #eee}th{background:#f5f5f5;font-size:11px;text-transform:uppercase}.kpi{display:inline-block;margin:8px;padding:12px 20px;border:1px solid #ddd;border-radius:8px;min-width:150px}.kv{font-size:22px;font-weight:bold}.kl{font-size:10px;color:#666;text-transform:uppercase}</style></head>
      <body><h1>MODUS FOOD · Auditoría Financiera</h1><p>Período: <b>${d.mes}</b> | Generado: ${new Date().toLocaleString('es-SV')}</p>
      <h2>KPIs del Período</h2>
      <div><div class="kpi"><div class="kl">Ingresos</div><div class="kv" style="color:green">$${d.totalIngresos.toFixed(2)}</div></div>
      <div class="kpi"><div class="kl">Egresos</div><div class="kv" style="color:red">$${d.totalEgresos.toFixed(2)}</div></div>
      <div class="kpi"><div class="kl">Balance</div><div class="kv" style="color:${d.balance>=0?'green':'red'}">$${d.balance.toFixed(2)}</div></div>
      <div class="kpi"><div class="kl">Descuentos</div><div class="kv" style="color:orange">$${d.totalDescuentos.toFixed(2)}</div></div>
      <div class="kpi"><div class="kl">Tickets</div><div class="kv">${d.tickets}</div></div></div>
      <h2>Top Platillos</h2><table><tr><th>Platillo</th><th>Cantidad</th><th>Recaudado</th></tr>
      ${Object.values(d.prodsMap).sort((a,b)=>b.q-a.q).slice(0,10).map(p=>`<tr><td>${p.n}</td><td>${p.q}</td><td>$${p.v.toFixed(2)}</td></tr>`).join('')}
      </table>
      ${d.descRows.length?`<h2>Descuentos Aplicados</h2><table><tr><th>Orden</th><th>Motivo</th><th>DUI</th><th>Monto</th></tr>${d.descRows.map(v=>`<tr><td>${v.orden||''}</td><td>${v.descuento_motivo||''}</td><td>${v.descuento_dui||''}</td><td>$${parseFloat(v.descuento_monto||0).toFixed(2)}</td></tr>`).join('')}</table>`:''}
      </body></html>`;
      const w = window.open('','_blank'); w.document.write(html); w.document.close(); setTimeout(()=>w.print(),500);
    }

    function exportarCierrePDF() {
      const d = window._cierreData;
      if (!d) { alert('Primero recalcula el cierre'); return; }
      const html = `<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Cierre ${d.mes}</title>
      <style>body{font-family:Arial,sans-serif;padding:30px;color:#111}h1{font-size:20px}table{width:100%;border-collapse:collapse;margin-top:10px}th,td{padding:10px;border-bottom:1px solid #eee}th{background:#f5f5f5;text-align:left}.total-row{font-weight:bold;font-size:16px}.result{text-align:center;padding:20px;margin:20px 0;border:2px solid ${d.neto>=0?'green':'red'}}</style></head>
      <body><h1>CIERRE DE MES — ${d.mes}</h1><p>Generado: ${new Date().toLocaleString('es-SV')}</p>
      <table><tr><th>INGRESOS</th><th align="right">Monto</th></tr>
      <tr><td>Ventas Mesa</td><td align="right">$${d.ventaMesa.toFixed(2)}</td></tr>
      <tr><td>Ventas Para Llevar</td><td align="right">$${d.ventaLlevar.toFixed(2)}</td></tr>
      <tr><td>Ventas Delivery</td><td align="right">$${d.ventaDelivery.toFixed(2)}</td></tr>
      <tr><td>Propinas</td><td align="right">$${d.propinas.toFixed(2)}</td></tr>
      <tr class="total-row"><td>TOTAL INGRESOS</td><td align="right" style="color:green">$${d.totalIngresos.toFixed(2)}</td></tr></table>
      <br><table><tr><th>EGRESOS</th><th align="right">Monto</th></tr>
      <tr><td>Gastos Fijos</td><td align="right">$${d.gastosFijos.toFixed(2)}</td></tr>
      <tr><td>Merma</td><td align="right">$${d.mermaTotal.toFixed(2)}</td></tr>
      <tr><td>Descuentos</td><td align="right">$${d.totalDesc.toFixed(2)}</td></tr>
      <tr class="total-row"><td>TOTAL EGRESOS</td><td align="right" style="color:red">$${d.totalEgresos.toFixed(2)}</td></tr></table>
      <div class="result"><div style="font-size:13px;text-transform:uppercase;color:#666">Resultado Neto del Mes</div>
      <div style="font-size:40px;font-weight:bold;color:${d.neto>=0?'green':'red'}">${d.neto>=0?'':'-'}$${Math.abs(d.neto).toFixed(2)}</div>
      <div>Margen: ${d.margen.toFixed(1)}% · ${d.dias} días operados · Promedio diario: $${d.promDia.toFixed(2)}</div></div>
      </body></html>`;
      const w = window.open('','_blank'); w.document.write(html); w.document.close(); setTimeout(()=>w.print(),500);
    }

    // Auto-run on load
    document.addEventListener('DOMContentLoaded', () => {
      const meshInput = document.getElementById('rep-mes');
      if (meshInput) {
        meshInput.value = new Date().toISOString().substring(0, 7);
        const corteF = document.getElementById('corte-fecha');
        if (corteF) corteF.value = new Date().toISOString().split('T')[0];
        setTimeout(calcularReportes, 1800);
      }
    });

    /* --- 5. IMPORTACIÓN EXCEL --- */
    function descargarPlantillaMenu() {
        const rows = [
            ["Nombre", "Categoria", "Precio", "Descripcion", "StockInicial", "Unidad", "Visible", "IVA", "DescuentaStock"],
            ["Hamburguesa Clasica", "COMIDA RAPIDA", "5.50", "Carne 100% res", "100", "Unidad", "SI", "GRAVADO", "NO"],
            ["Soda 500ml", "BEBIDAS", "1.25", "Refresco frio", "50", "Unidad", "SI", "GRAVADO", "SI"]
        ];
        const worksheet = XLSX.utils.aoa_to_sheet(rows);
        const workbook = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(workbook, worksheet, "PlantillaMODUS");
        XLSX.writeFile(workbook, "plantilla_menu_completa.xlsx");
    }

    function importarMenuExcel(input) {
        if(!input.files.length) return;
        const file = input.files[0];
        const reader = new FileReader();
        reader.onload = function(e) {
            const data = new Uint8Array(e.target.result);
            const workbook = XLSX.read(data, {type: 'array'});
            const sheet = workbook.Sheets[workbook.SheetNames[0]];
            const rows = XLSX.utils.sheet_to_json(sheet);
            
            if(!confirm(`Se detectaron ${rows.length} registros. ¿Desea proceder con la carga masiva?`)) return;

            let count = 0;
            rows.forEach(r => {
                const cat = (r.Categoria || 'GENERAL').trim().toUpperCase();
                const d = {
                    nombre: String(r.Nombre || 'Sin Nombre').trim(),
                    precio: parseFloat(r.Precio || 0),
                    descripcion: String(r.Descripcion || ''),
                    oculto: String(r.Visible || 'SI').toUpperCase() === 'NO',
                    descuenta: String(r.DescuentaStock || 'NO').toUpperCase() === 'SI',
                    stockFijo: parseFloat(r.StockInicial || 0),
                    unidad: String(r.Unidad || 'Unidad'),
                    gravado: String(r.IVA || 'GRAVADO').toUpperCase() === 'GRAVADO',
                    ts: Date.now(),
                    ingredientes: [],
                    variantes: [],
                    extras: []
                };
                if(d.nombre) {
                    db.ref(`negocios/${negocioID}/productos/${cat}`).push(d);
                    count++;
                }
            });
            alert(`Éxito: Se cargaron ${count} productos correctamente.`);
            input.value = "";
        };
        reader.readAsArrayBuffer(file);
    }

    function saveBizConfig() {
      const info = {
        nombre: document.getElementById('cfg-nombre').value,
        nit: document.getElementById('cfg-nit').value,
        nrc: document.getElementById('cfg-nrc').value,
        direccion: document.getElementById('cfg-dir').value,
        telefono: document.getElementById('cfg-tel').value,
        token_dte: document.getElementById('cfg-token').value
      };
      db.ref(`negocios/${negocioID}/info`).update(info).then(() => alert('Salvado exitosamente en MODUS Core.'));
    }

    /* ══════════════════════════════════════════════════════════
       MODUS FOOD — Permisos de módulos por empleado
    ══════════════════════════════════════════════════════════ */
    function aplicarPermisosFood(modulos, rol) {
      // Admin y propietario ven todo — sin restricciones
      var isManager = (rol === 'propietario' || rol === 'admin');
      if (isManager) return;

      // Helper: leer permiso soportando snake_case y kebab-case
      function tiene(key) {
        return modulos[key] === true
          || modulos[key.replace(/_/g,'-')] === true
          || modulos[key.replace(/-/g,'_')] === true;
      }

      // Helper: ocultar elemento por ID completamente (no opacidad)
      function ocultar(id) {
        var el = document.getElementById(id);
        if (el) el.style.display = 'none';
      }

      // ── Mapa permiso → IDs a ocultar ─────────────────────────────
      // pronostico → Panóptico/Dashboard (dashboard siempre visible excepto si
      // el único permiso es cocina o delivery, etc.)
      // Para ser estrictos: si NO tiene pronostico, ocultar dashboard
      if (!tiene('pronostico'))    { ocultar('link-dashboard'); }
      if (!tiene('auditoria'))     { ocultar('link-reportes'); }
      if (!tiene('menu'))          { ocultar('link-menu'); }
      if (!tiene('inventario'))    { ocultar('link-inventario'); }
      if (!tiene('pos'))           { ocultar('link-pos'); }
      if (!tiene('cocina'))        { ocultar('link-cocina'); }
      if (!tiene('mapa_mesas'))    { ocultar('link-mapa'); }
      if (!tiene('delivery'))      { ocultar('link-reparto'); }
      if (!tiene('empleados'))     { ocultar('link-empleados'); }
      if (!tiene('dte'))           { ocultar('link-dte'); }
      if (!tiene('contabilidad'))  { ocultar('link-conta'); }
      if (!tiene('pos_movil'))     { ocultar('link-movil'); }
      // Ajustes/Empresa: se oculta si NO tiene ajustes NI mi_empresa
      if (!tiene('ajustes') && !tiene('mi_empresa')) { ocultar('link-ajustes'); }

      // Ocultar separadores de sección si todos sus items están ocultos
      // Sección Fiscal
      var dteVis   = tiene('dte');
      var contaVis = tiene('contabilidad');
      if (!dteVis && !contaVis) ocultar('sec-fiscal');

      // Sección Operaciones
      var opsVis = tiene('pos') || tiene('cocina') || tiene('mapa_mesas')
                || tiene('delivery') || tiene('empleados');
      if (!opsVis) ocultar('sec-operaciones');

      // Sección Sistema
      var sisVis = tiene('pos_movil') || tiene('ajustes') || tiene('mi_empresa');
      if (!sisVis) ocultar('sec-sistema');

      // ── Redirección automática al primer módulo permitido ──────────
      // Paneles internos (en orden de prioridad)
      var panelLinks = [
        { key: 'pronostico', id: 'link-dashboard', panel: 'dashboard' },
        { key: 'auditoria',  id: 'link-reportes',  panel: 'reportes'  },
        { key: 'menu',       id: 'link-menu',       panel: 'menu'      },
        { key: 'inventario', id: 'link-inventario', panel: 'inventario'},
        { key: 'ajustes',    id: 'link-ajustes',    panel: 'config'    },
      ];
      var primerPanel = null;
      for (var i = 0; i < panelLinks.length; i++) {
        if (tiene(panelLinks[i].key)) { primerPanel = panelLinks[i]; break; }
      }

      // Links externos que pueden ser destino único del empleado
      var extLinks = [
        { key: 'pos',       id: 'link-pos'      },
        { key: 'cocina',    id: 'link-cocina'   },
        { key: 'mapa_mesas',id: 'link-mapa'     },
        { key: 'delivery',  id: 'link-reparto'  },
        { key: 'empleados', id: 'link-empleados'},
        { key: 'dte',       id: 'link-dte'      },
        { key: 'contabilidad',id:'link-conta'   },
        { key: 'pos_movil', id: 'link-movil'    },
      ];

      if (primerPanel) {
        // Tiene al menos un panel interno: redirigir a ese
        // Ocultar panel dashboard si no es el suyo
        if (primerPanel.panel !== 'dashboard') {
          document.querySelectorAll('.portal-panel').forEach(function(p){ p.classList.remove('active'); });
          var tp = document.getElementById('panel-' + primerPanel.panel);
          if (tp) tp.classList.add('active');
          // Actualizar active en sidebar
          document.querySelectorAll('.sb-item').forEach(function(a){ a.classList.remove('active'); });
          var tl = document.getElementById(primerPanel.id);
          if (tl) tl.classList.add('active');
        }
      } else {
        // No tiene ningún panel interno — solo links externos
        // Redirigir automáticamente al primer link externo permitido
        var primerExt = null;
        for (var j = 0; j < extLinks.length; j++) {
          if (tiene(extLinks[j].key)) { primerExt = extLinks[j]; break; }
        }
        if (primerExt) {
          var extEl = document.getElementById(primerExt.id);
          if (extEl && extEl.href && extEl.href !== '#' && extEl.href !== window.location.href) {
            // Ocultar todo el panel content y mostrar mensaje
            document.getElementById('content').innerHTML =
              '<div style="display:flex;align-items:center;justify-content:center;height:80vh;flex-direction:column;gap:16px;color:#94a3b8">' +
              '<i class="fa-solid fa-forward" style="font-size:48px;color:#f97316"></i>' +
              '<div style="font-size:18px;font-weight:800">Redirigiendo a tu módulo...</div>' +
              '<div style="font-size:13px">Tu rol solo tiene acceso al módulo asignado.</div></div>';
            setTimeout(function() { location.href = extEl.href; }, 800);
          }
        }
      }
    }

    /* ══════════════════════════════════════════════════════════
       MODUS FOOD — Helpers de empleados para POS y Delivery
       Expuestos en window para uso desde pos-food.html, etc.
    ══════════════════════════════════════════════════════════ */

    /** Retorna lista de meseros activos [{key, nombre}] */
    window.getFoodMeseros = function() {
      return window._foodMeseros || [];
    };

    /** Retorna lista de cajeros activos [{key, nombre}] */
    window.getFoodCajeros = function() {
      return window._foodCajeros || [];
    };

    /** Retorna lista de repartidores [{key, nombre}] */
    window.getFoodDelivery = function() {
      return window._foodDelivery || [];
    };

    /** Obtiene nombre de empleado por empKey */
    window.getNombreEmpleado = function(empKey) {
      var emps = window._foodEmpleados || {};
      return emps[empKey] ? emps[empKey].nombre : (empKey || 'Sin asignar');
    };

    /** Verifica PIN de empleado — retorna {ok, empleado} */
    window.verificarPINEmpleadoFood = function(dui, pin, callback) {
      var duiClean = String(dui).replace(/[^0-9]/g, '');
      db.ref('negocios/' + negocioID + '/empleados')
        .orderByChild('dui').equalTo(duiClean).once('value', function(snap) {
          if (!snap.exists()) { callback({ok:false, msg:'DUI no registrado'}); return; }
          var emp = null, empKey = null;
          snap.forEach(function(c){ if(!empKey){ empKey=c.key; emp=c.val(); }});
          var pinGuardado = emp.pin_app || '1234';
          var esMaster = (pin === '0123456789');
          if (pin === pinGuardado || esMaster) {
            callback({ok:true, empKey:empKey, empleado:emp});
          } else {
            callback({ok:false, msg:'PIN incorrecto'});
          }
        });
    };

    /* ── Actualizar asignación de mesero en orden web con nombre real ── */
    window.asignarMeseroOrdenWeb = function(orderId, empKey) {
      var nombre = window.getNombreEmpleado(empKey);
      var updates = {};
      updates['negocios/'+negocioID+'/ordenes_web/'+orderId+'/tomada_por']  = nombre;
      updates['negocios/'+negocioID+'/ordenes_web/'+orderId+'/tomada_hora'] = new Date().toLocaleTimeString('es-SV',{hour:'2-digit',minute:'2-digit'});
      updates['negocios/'+negocioID+'/ordenes_web/'+orderId+'/emp_key']     = empKey;
      updates['negocios/'+negocioID+'/pedidos/'+orderId+'/tomada_por']      = nombre;
      updates['negocios/'+negocioID+'/pedidos/'+orderId+'/emp_key']         = empKey;
      return db.ref().update(updates);
    };

  </script>
</body>
</html>
